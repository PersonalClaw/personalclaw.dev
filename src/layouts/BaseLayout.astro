---
import "@fontsource-variable/dm-sans";
import "@fontsource-variable/jetbrains-mono";
import dmSansLatin from "@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url";
import "../styles/global.css";
import tokensCss from "../styles/tokens.css?raw";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {
  buildStructuredData,
  SOCIAL_IMAGE_ALT,
  SOCIAL_IMAGE_HEIGHT,
  SOCIAL_IMAGE_PATH,
  SOCIAL_IMAGE_WIDTH,
  type ArticleFacts
} from "../data/structured-data";

interface Props {
  title?: string;
  description?: string;
  /** Set by blog post pages: emits an Article node in the JSON-LD graph. */
  article?: ArticleFacts;
  /** Set by the 404 page: nothing there ranks, though its links may be followed. */
  notFound?: boolean;
}

const {
  title = "PersonalClaw · Your personal agentic OS",
  description = "A self-hosted agentic operating system for chat, autonomous goals, memory, knowledge, automation, and replaceable apps.",
  article,
  notFound = false
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(SOCIAL_IMAGE_PATH, Astro.site);
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isPreview = import.meta.env.VERCEL_ENV === "preview";
const robots = isPreview ? "noindex, nofollow" : notFound ? "noindex, follow" : "index, follow";
// The browser chrome takes the canvas colour from the token, since a <meta> attribute cannot
// hold a `var(--…)`. A hard-coded hex here drifted from the canvas whenever it changed (X10 in
// docs/site-audit.md); a token that is gone fails the build instead.
const canvas = tokensCss.match(/--night:\s*(#[0-9a-fA-F]{3,8})\b/)?.[1];
if (!canvas) throw new Error("BaseLayout: tokens.css defines no --night canvas colour for theme-color");

// The JSON-LD graph is built by src/data/structured-data.ts, which the Starlight /docs
// head override calls too — one builder, so the two renderers cannot publish two
// different shapes for the same site.
const structuredData = buildStructuredData({
  site: new URL(Astro.site ?? "https://personalclaw.dev/"),
  pathname,
  title,
  description,
  article
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={canvas} />
    <meta name="robots" content={robots} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PersonalClaw" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content={SOCIAL_IMAGE_WIDTH} />
    <meta property="og:image:height" content={SOCIAL_IMAGE_HEIGHT} />
    <meta property="og:image:alt" content={SOCIAL_IMAGE_ALT} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={SOCIAL_IMAGE_ALT} />
    <link
      rel="preload"
      href={dmSansLatin}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="PersonalClaw writing" href="/blog/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/brand/personalclaw-mark.svg" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)}></script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header pathname={pathname} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer pathname={pathname} />
  </body>
</html>
