---
import { Image } from "astro:assets";
import {
  ArrowRight,
  Bot,
  Box,
  Check,
  CirclePause,
  CirclePlay,
  Database,
  Eye,
  KeyRound,
  Network,
  PlugZap,
  ScanSearch,
  ShieldCheck,
  Terminal,
  Workflow
} from "lucide-react";
import appsCapture from "../assets/apps.png";
import loopsCapture from "../assets/loops.png";
import SystemWindow from "../components/SystemWindow.astro";
import { CopyCommand } from "../components/CopyCommand";
import BaseLayout from "../layouts/BaseLayout.astro";
import { apps } from "../data/apps";
import { installerPython } from "../data/installer.mjs";
import { releaseFacts } from "../data/release";
import { GITHUB_URL, INSTALL_COMMAND } from "../data/site";

// The quickstart names the Python the one-liner installs on, read from the installer /install
// serves (src/data/installer.mjs), so the page and the script cannot name two versions.
const INSTALLER_PYTHON = installerPython();

// The tape names apps by SLUG and resolves each one through src/data/apps.ts, whose names
// and categories src/data/release.ts already checks against every manifest at the pinned
// apps commit. So a bundle renamed or dropped between releases fails the build here
// instead of leaving the homepage advertising an app that /apps cannot show.
//
// It used to be a literal array of twelve display strings. All twelve happened to be
// correct, which is the problem with a transcribed list: it is only ever verified by
// somebody choosing to re-check it, and nothing here was going to.
const featuredSlugs = [
  "openai-models",
  "anthropic-models",
  "bedrock-models",
  "google-models",
  "vllm-models",
  "claude-code-agent",
  "codex-agent",
  "tavily-search",
  "slack-channel",
  "git-sync",
  "minutes",
  "growth"
];

/*
 * THE INSTALL LINE BELOW NO LONGER SAYS "every path installs the same release artifact".
 * That held for three of the four paths: uv, pipx and pip each install the one published
 * PyPI wheel. The container path does not. `deploy/compose/compose.yaml` PULLS two prebuilt
 * images — `personalclaw-gateway` and `personalclaw-web` — rather than installing the wheel,
 * so it is a different artifact and a different topology, and "one artifact" made Compose
 * sound like a packaging preference. It also does not BUILD: an earlier draft of this line
 * said Compose builds the tagged source, which is only true of the separate
 * `compose.build.yaml`; the default file resolves image tags and starts them.
 *
 * WORTH KNOWING BEFORE THIS LINE GROWS ANY CLAIM ABOUT THE CONTAINER DASHBOARD: the
 * published gateway image for v0.1.3 did not serve the SPA — measured then,
 * `GET /` on `personalclaw-gateway:latest` answered 503 "PersonalClaw — Build the dashboard"
 * while `/api/healthz` reported 200 and version 0.1.3. Compose still reaches a dashboard
 * because the `personalclaw-web` image serves it, which is exactly why this sentence names
 * a PAIR. Do not shorten it to "run the gateway in Docker and open the dashboard".
 *
 * (All of this is frontmatter, not a template comment: Astro emits template comments into
 * the HTML, and a retracted claim should not ship inside the page that retracted it.)
 *
 * THE `{" "}` IN THAT PARAGRAPH IS LOAD-BEARING. Astro's HTML compression drops the
 * newline-plus-indent between `see the` and the `<a>` on the next line, so the built markup
 * read `see the<a …>install guide</a>` — one glued word. The old sentence hid it: `theinstall`
 * did not fit the line, so `overflow-wrap` broke it mid-token at exactly the point the missing
 * space would have been, and the page looked correct. The rewrite above shortened the line
 * enough for both words to share it, and the defect became visible at 390px. An explicit
 * `{" "}` is the fix the release note below already uses for the same reason.
 */
const appsBySlug = new Map(apps.map((app) => [app.slug, app]));
const unknownFeatured = featuredSlugs.filter((slug) => !appsBySlug.has(slug));
if (unknownFeatured.length > 0) {
  throw new Error(
    `src/pages/index.astro features app slug(s) that are not in the pinned app ` +
      `directory: ${unknownFeatured.join(", ")}. Either the bundle was renamed or ` +
      `removed upstream, or the slug is a typo — the homepage must not name an app ` +
      `that /apps cannot show.`
  );
}
const featuredApps = featuredSlugs.map((slug) => appsBySlug.get(slug)!.name);
---

<BaseLayout>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-field">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <span class="hero-mark" aria-hidden="true"></span>
          <h1 class="display" id="home-title">PersonalClaw</h1>
          <p class="hero-line">One agentic OS.<br />Your machine. Your rules.</p>
          <p class="hero-support">
            Chat, autonomous goals, memory, knowledge, and automation behind one
            gateway you own.
          </p>
          <div class="hero-actions">
            <a
              class="button button-primary hero-cta"
              href={GITHUB_URL}
              target="_blank"
              rel="noreferrer"
            >
              Get PersonalClaw
            </a>
            <a class="hero-tour-link" href="/product#tour">
              <CirclePlay size={18} aria-hidden="true" />
              Watch the tour
            </a>
          </div>
        </div>
        <div class="hero-window">
          <SystemWindow />
        </div>
      </div>
    </div>
    <div class="hero-theater">
      <div class="shell">
        <ul class="hero-facts" aria-label="Project facts">
          <li><Check size={15} aria-hidden="true" /> MIT licensed</li>
          <li><Check size={15} aria-hidden="true" /> No usage tracking</li>
          <li><Check size={15} aria-hidden="true" /> Self-hosted</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-rule ownership" id="system">
    <div class="shell">
      <div class="statement">
        <p class="kicker">Built for one owner</p>
        <h2>Not another account. A system that belongs to you.</h2>
      </div>

      <div class="ownership-grid">
        <article>
          <span class="index">01</span>
          <Database size={24} aria-hidden="true" />
          <h3>Your state stays home.</h3>
          <p>
            Conversations, memory, knowledge, configuration, and app state live
            under one PersonalClaw home on infrastructure you control.
          </p>
        </article>
        <article>
          <span class="index">02</span>
          <Eye size={24} aria-hidden="true" />
          <h3>Autonomy stays visible.</h3>
          <p>
            Goal loops expose their plan, current cycle, tool activity, and
            output. Pause, nudge, or stop the work at any time.
          </p>
        </article>
        <article>
          <span class="index">03</span>
          <PlugZap size={24} aria-hidden="true" />
          <h3>Every vendor is removable.</h3>
          <p>
            Model providers, search, speech, channels, tools, and agent runtimes
            connect through an app boundary instead of the core.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section product-story">
    <div class="shell story-layout">
      <div class="story-copy">
        <p class="kicker">Goal loops</p>
        <h2 class="section-title">Delegate an outcome. Keep the controls.</h2>
        <p>
          PersonalClaw classifies a goal, builds a plan, and works cycle by
          cycle under a deterministic supervisor. It can run without constant
          prompting without disappearing behind a spinner.
        </p>
        <ul class="proof-list">
          <li><CirclePause size={19} aria-hidden="true" /> Pause, nudge, or stop a loop</li>
          <li><Workflow size={19} aria-hidden="true" /> Inspect every cycle and result</li>
          <li><ShieldCheck size={19} aria-hidden="true" /> Keep tool approvals in the host</li>
        </ul>
        <a class="text-link" href="/product">
          Tour the product <ArrowRight size={17} aria-hidden="true" />
        </a>
      </div>
      <div class="story-media">
        <Image
          src={loopsCapture}
          alt="A finished PersonalClaw goal loop with its cycle, time, spend, and the deliverable it reported"
          widths={[640, 960, 1280]}
          sizes="(max-width: 900px) 100vw, 62vw"
          format="webp"
          quality={86}
        />
      </div>
    </div>
  </section>

  <section class="section section-rule architecture">
    <div class="shell">
      <div class="section-head">
        <div>
          <p class="kicker">One local gateway</p>
          <h2>A coherent system, not a pile of prompts.</h2>
        </div>
        <p>
          The gateway coordinates interfaces, agentic work, durable context, and
          permission-gated apps. Core operation remains available without a
          network connection.
        </p>
      </div>

      <div class="system-path" aria-label="PersonalClaw system architecture">
        <article>
          <span>You</span>
          <Terminal size={26} aria-hidden="true" />
          <h3>Dashboard · CLI · channels</h3>
        </article>
        <span class="path-arrow" aria-hidden="true">→</span>
        <article>
          <span>Gateway</span>
          <Network size={26} aria-hidden="true" />
          <h3>One process, one API</h3>
        </article>
        <span class="path-arrow" aria-hidden="true">→</span>
        <article>
          <span>Agentic core</span>
          <Bot size={26} aria-hidden="true" />
          <h3>Chat · loops · automation</h3>
        </article>
        <span class="path-arrow" aria-hidden="true">→</span>
        <article>
          <span>Context</span>
          <Database size={26} aria-hidden="true" />
          <h3>Memory · knowledge · skills</h3>
        </article>
        <span class="path-arrow" aria-hidden="true">→</span>
        <article>
          <span>Apps</span>
          <Box size={26} aria-hidden="true" />
          <h3>Your vendors and tools</h3>
        </article>
      </div>
    </div>
  </section>

  <section class="section ecosystem">
    <div class="shell">
      <div class="ecosystem-intro">
        <div>
          <p class="kicker">First-party ecosystem</p>
          <h2 class="section-title">{releaseFacts.apps.total} apps. No permanent provider.</h2>
        </div>
        <a class="button button-secondary" href="/apps">
          Browse all apps <ArrowRight size={18} aria-hidden="true" />
        </a>
      </div>

      <div class="app-tape" aria-label="Featured first-party apps">
        {featuredApps.map((app) => (
          <span>{app}</span>
        ))}
      </div>

      <div class="ecosystem-stage">
        <div class="ecosystem-note">
          <p>
            Install models, search, tools, speech, channels, ACP agents, and
            complete product interfaces from one permission-aware store.
          </p>
          <dl>
            <div>
              <dt>{releaseFacts.apps.total}</dt>
              <dd>First-party apps</dd>
            </div>
            <div>
              <dt>{releaseFacts.apps.categoryCount}</dt>
              <dd>App categories</dd>
            </div>
            <div>
              <dt>1</dt>
              <dd>App contract</dd>
            </div>
          </dl>
        </div>
        <Image
          src={appsCapture}
          alt="PersonalClaw app store showing installed and available apps"
          widths={[640, 960, 1280]}
          sizes="(max-width: 900px) 100vw, 68vw"
          format="webp"
          quality={86}
        />
      </div>
    </div>
  </section>

  <section class="section security-band">
    <div class="shell security-layout">
      <div class="security-copy">
        <p class="kicker">Security is architecture</p>
        <h2 class="section-title">Autonomy with a boundary.</h2>
        <p>
          The model can propose. Deterministic controls decide what reaches your
          shell, network, and installed app surface.
        </p>
        <a class="text-link" href="/security">
          Inspect the security model <ArrowRight size={17} aria-hidden="true" />
        </a>
      </div>

      <div class="security-controls">
        <article>
          <ShieldCheck size={22} aria-hidden="true" />
          <div>
            <h3>Host approval gate</h3>
            <p>Tool policy remains outside the model and spawned agent.</p>
          </div>
        </article>
        <article>
          <ScanSearch size={22} aria-hidden="true" />
          <div>
            <h3>Quarantine and scanner gate</h3>
            <p>App installation pauses before enablement when risk is detected.</p>
          </div>
        </article>
        <article>
          <KeyRound size={22} aria-hidden="true" />
          <div>
            <h3>Scoped app tokens</h3>
            <p>Apps call the gateway with bounded tokens; their own code still runs as you, and the install review says so.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section quickstart">
    <div class="narrow">
      <p class="kicker">Run it yourself</p>
      <h2 class="section-title">One command to a local gateway.</h2>
      <p class="quickstart-lede">
        The installer brings its own Python {INSTALLER_PYTHON} via <code>uv</code> — nothing to
        set up first. The dashboard opens at <code>localhost:10000</code> after
        the gateway starts. Prefer <code>uv</code> directly, pipx, or pip? All
        three install the same published wheel. Docker Compose runs a published
        gateway and dashboard image pair instead — see the{" "}
        <a href="/docs/guides/getting-started">install guide</a
        >.
      </p>
      <CopyCommand command={INSTALL_COMMAND} client:idle />
      <div class="release-note">
        <strong>Package version {releaseFacts.core.versionLabel}.</strong>
        <p>
          {releaseFacts.status.summary}{" "}
          <a href="/release">Inspect the exact sources.</a>
        </p>
      </div>
      <a
        class="button button-primary final-cta"
        href={GITHUB_URL}
        target="_blank"
        rel="noreferrer"
      >
        Get PersonalClaw
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Direction A (#87, DESIGN.md "Home's first viewport"): the proposition on the coral
     field, and the System Window hanging across the field's lower edge into the dark
     theater, so the brand and the product proof share the first screen. --hero-overlap
     is how far the window reaches past the coral; the theater's top padding returns it. */
  .home-hero {
    --hero-overlap: clamp(6.5rem, 13vw, 12.5rem);
    background: var(--theater);
  }

  .hero-field {
    padding-top: clamp(2rem, 4vw, 3.5rem);
    background: var(--coral);
    color: var(--coral-ink);
  }

  .hero-field .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 7fr);
    gap: clamp(2rem, 4vw, 4.5rem);
    align-items: center;
  }

  /* Text and focus on coral are dark ink, never white or coral (5.8:1). */
  .hero-field :focus-visible {
    outline-color: var(--coral-ink);
  }

  /* The wordmark is one word that must not break: the display role, capped by the copy
     column (the word is about 6em wide in DM Sans 300), so it fits at every width. */
  .hero-copy {
    --hero-display: min(var(--fs-display), 16cqi);
    container-type: inline-size;
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .hero-mark {
    display: block;
    width: 52px;
    height: 52px;
    margin-bottom: 1.4rem;
    background: var(--coral-ink);
    mask: url("/brand/personalclaw-mark.svg") center / contain no-repeat;
  }

  h1 {
    margin-bottom: 0.45rem;
    color: var(--coral-ink);
    font-size: var(--hero-display);
  }

  .hero-line {
    max-width: 11ch;
    margin-bottom: 1.2rem;
    font-size: clamp(1.45rem, 2.7vw, 2.45rem);
    font-weight: 520;
    line-height: 1.08;
  }

  .hero-support {
    max-width: 30rem;
    margin-bottom: 1.75rem;
    font-size: 1.08rem;
    font-weight: 450;
  }

  .hero-actions {
    display: flex;
    gap: 0.5rem 1.4rem;
    align-items: center;
    flex-wrap: wrap;
  }

  /* The coral button would vanish on the coral field: here the primary action is the
     field's own ink, with coral type (5.8:1, and 5.8:1 between the pill and the field). */
  .hero-cta {
    background: var(--coral-ink);
    color: var(--coral);
  }

  .hero-cta:hover {
    background: var(--night);
    color: var(--coral-bright);
  }

  .hero-tour-link {
    display: inline-flex;
    min-height: 44px;
    gap: 0.45rem;
    align-items: center;
    color: var(--coral-ink);
    font-size: var(--fs-label);
    font-weight: 650;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .hero-tour-link:hover {
    text-decoration-thickness: 2px;
  }

  .hero-window {
    position: relative;
    z-index: 1;
    align-self: end;
    margin-bottom: calc(-1 * var(--hero-overlap));
    animation: window-arrive 650ms 120ms both cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero-window :global(.system-window) {
    box-shadow: 0 32px 80px color-mix(in srgb, var(--coral-ink) 45%, transparent);
  }

  .hero-theater {
    padding-block: calc(var(--hero-overlap) + 1.5rem) 2.5rem;
    border-bottom: 1px solid var(--line);
  }

  .hero-facts {
    display: flex;
    margin: 0;
    padding: 0;
    gap: 1.25rem;
    flex-wrap: wrap;
    justify-content: end;
    color: var(--ink-muted);
    font-size: 0.82rem;
    list-style: none;
  }

  .hero-facts li {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
  }

  .hero-facts svg {
    color: var(--success);
  }

  .statement {
    display: grid;
    grid-template-columns: 0.5fr 1.5fr;
    gap: 2rem;
    align-items: start;
  }

  .statement .kicker {
    margin-top: 0.75rem;
  }

  .statement h2 {
    max-width: 16ch;
  }

  .ownership-grid {
    display: grid;
    margin-top: clamp(4rem, 9vw, 8rem);
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
  }

  .ownership-grid article {
    position: relative;
    padding: 2.25rem 2.5rem 0 0;
    border-right: 1px solid var(--line);
  }

  .ownership-grid article + article {
    padding-left: 2.5rem;
  }

  .ownership-grid article:last-child {
    border-right: 0;
  }

  .ownership-grid .index {
    position: absolute;
    top: 1rem;
    right: 1rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .ownership-grid svg {
    margin-bottom: 3.5rem;
    color: var(--coral);
  }

  .ownership-grid h3 {
    margin-bottom: 0.65rem;
    font-size: 1.35rem;
    font-weight: 580;
  }

  .ownership-grid p {
    max-width: 29rem;
    margin: 0;
    color: var(--ink-soft);
  }

  .product-story {
    overflow: hidden;
    background: var(--night-soft);
  }

  .story-layout {
    display: grid;
    grid-template-columns: minmax(280px, 0.7fr) minmax(620px, 1.3fr);
    gap: clamp(3rem, 7vw, 8rem);
    align-items: center;
  }

  .story-copy h2,
  .ecosystem-intro h2,
  .security-copy h2,
  .quickstart h2 {
    margin-bottom: 1.5rem;
  }

  .story-copy > p:not(.kicker),
  .security-copy > p:not(.kicker) {
    color: var(--ink-soft);
    font-size: 1.08rem;
  }

  .proof-list {
    display: grid;
    padding: 1.25rem 0;
    gap: 0;
    list-style: none;
  }

  .proof-list li {
    display: flex;
    min-height: 48px;
    gap: 0.75rem;
    align-items: center;
    border-bottom: 1px solid var(--line);
    color: var(--ink-soft);
  }

  .proof-list svg {
    color: var(--coral);
  }

  .text-link {
    display: inline-flex;
    min-height: 44px;
    gap: 0.45rem;
    align-items: center;
    color: var(--coral-bright);
    font-weight: 650;
  }

  .text-link:hover {
    color: var(--ink);
  }

  .story-media {
    margin-right: min(-6vw, -2rem);
  }

  .story-media :global(img),
  .ecosystem-stage :global(img) {
    width: 100%;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    box-shadow: 0 35px 90px rgba(0, 0, 0, 0.42);
  }

  .system-path {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr auto 1fr;
    align-items: stretch;
    border-block: 1px solid var(--line);
  }

  .system-path article {
    display: flex;
    min-height: 210px;
    padding: 1.4rem;
    flex-direction: column;
  }

  .system-path article > span {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .system-path svg {
    margin: auto 0 1rem;
    color: var(--coral);
  }

  .system-path h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 560;
  }

  .path-arrow {
    display: grid;
    min-width: 38px;
    place-items: center;
    color: var(--coral);
  }

  .ecosystem {
    overflow: hidden;
  }

  .ecosystem-intro {
    display: flex;
    gap: 2rem;
    align-items: end;
    justify-content: space-between;
  }

  .ecosystem-intro h2 {
    max-width: 13ch;
    margin-bottom: 0;
  }

  .app-tape {
    display: flex;
    width: max-content;
    margin: 4rem 0;
    gap: 0.55rem;
    transform: translateX(-3rem);
  }

  .app-tape span {
    display: inline-flex;
    min-height: 44px;
    padding: 0.55rem 1rem;
    align-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .ecosystem-stage {
    display: grid;
    grid-template-columns: minmax(260px, 0.5fr) minmax(600px, 1.5fr);
    gap: 3rem;
    align-items: end;
  }

  .ecosystem-note > p {
    color: var(--ink-soft);
    font-size: 1.05rem;
  }

  .ecosystem-note dl {
    display: grid;
    margin: 3rem 0 0;
    gap: 0;
  }

  .ecosystem-note dl div {
    display: grid;
    padding-block: 1rem;
    grid-template-columns: 70px 1fr;
    align-items: baseline;
    border-top: 1px solid var(--line);
  }

  .ecosystem-note dt {
    color: var(--coral);
    font-size: 1.6rem;
    font-weight: 650;
  }

  .ecosystem-note dd {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.85rem;
  }

  .security-band {
    border-block: 1px solid rgba(255, 107, 91, 0.22);
    background:
      linear-gradient(120deg, rgba(255, 107, 91, 0.1), transparent 38%),
      #0d0e0f;
  }

  .security-layout {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(3rem, 10vw, 10rem);
    align-items: center;
  }

  .security-copy h2 {
    max-width: 9ch;
  }

  .security-controls {
    border-top: 1px solid var(--line-strong);
  }

  .security-controls article {
    display: grid;
    min-height: 124px;
    padding: 1.5rem 0;
    grid-template-columns: 48px 1fr;
    gap: 1rem;
    align-items: start;
    border-bottom: 1px solid var(--line-strong);
  }

  .security-controls > article > svg {
    color: var(--coral);
  }

