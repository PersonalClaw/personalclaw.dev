---
import { CirclePause, CirclePlay, ShieldCheck, Workflow } from "lucide-react";
import inboxCapture from "../assets/inbox.png";
import loopsCapture from "../assets/loops.png";
import DeferredCapture from "../components/DeferredCapture.astro";
import InstallPanel from "../components/InstallPanel.astro";
import SystemWindow from "../components/SystemWindow.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { BUILDERS_SNIPPET } from "../data/apps-snippet.mjs";
import { capabilityMatrix } from "../data/capabilities.mjs";
import { homeQuestions } from "../data/faq.mjs";
import { releaseFacts } from "../data/release";
import { INSTALL_PANEL_ID } from "../data/site";
import { trustRows } from "../data/trust.mjs";

// Home runs PRODUCT.md's belief ladder in five chapters (#88, SITE-REDESIGN.md section 5.1):
// proof and install; delegation and control; the ownership boundary; apps and security; current
// maturity. Every number and version below comes from releaseFacts or the /compare matrix, and
// every link into core or apps is built from the commit the site pins.
const core = releaseFacts.core;
const coreBlob = `${core.source.repositoryUrl}/blob/${core.source.commit}`;
const appsBlob = `${releaseFacts.apps.source.repositoryUrl}/blob/${releaseFacts.apps.source.commit}`;

const trust = trustRows(core);

// The FAQ answers in the /compare rows' own words where a row exists, so an answer cannot say more
// than the row the matrix checked at the pin. The questions are data (src/data/faq.mjs), so the
// FAQPage in the structured data publishes exactly these answers.
const matrix = capabilityMatrix();
const questions = homeQuestions({ matrix, categories: releaseFacts.apps.categories });

// What lives under ~/.personalclaw, by core's own inventory (src/personalclaw/durability/inventory.py
// at the pin): its seven domains, each with stores it lists. A snapshot is exactly these domains.
const homeDomains = [
  { name: "Memory", stores: ["memory.db", "learning.db", "lessons.jsonl"] },
  { name: "Knowledge", stores: ["knowledge.db", "sources", "research_reports.json"] },
  { name: "Work", stores: ["sessions", "projects", "loop/loops.db", "artifacts"] },
  { name: "Automation", stores: ["triggers.json", "crons.json", "workflows"] },
  { name: "Platform", stores: ["apps", "agents", "skills", "inbox"] },
  { name: "Config", stores: ["config.json", "active_models.json", "mcp.json"] },
  { name: "Security", stores: ["credentials", "grants", "security_events.jsonl"] }
];
const inventoryUrl = `${coreBlob}/src/personalclaw/durability/inventory.py`;

// The app belt: every category at the pinned apps commit, each opening /apps filtered to it.
const categories = releaseFacts.apps.categories;
const appGuideUrl = `${appsBlob}/docs/app-creation-guide.md`;

const latest = core.changelog.latest;
---

<BaseLayout>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-field">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <span class="hero-mark" aria-hidden="true"></span>
          <h1 class="display" id="home-title">PersonalClaw</h1>
          <p class="hero-line">One agentic OS.<br />Your machine.<br />Your rules.</p>
          <p class="hero-support">
            Chat, autonomous goals, memory, knowledge, and automation behind one
            gateway you own.
          </p>
          <div class="hero-actions">
            <button class="button button-primary hero-cta" type="button" popovertarget={INSTALL_PANEL_ID}>
              Install PersonalClaw
            </button>
            <a class="hero-tour-link" href="/product#tour">
              <CirclePlay size={18} aria-hidden="true" />
              Watch the tour
            </a>
          </div>
        </div>
        <div class="hero-window">
          <SystemWindow />
        </div>
      </div>
    </div>
  </section>

  <InstallPanel />

  <section class="section trust" aria-labelledby="trust-title">
    <div class="shell">
      <div class="chapter-head">
        <h2 class="section-title" id="trust-title">Check it before you trust it.</h2>
        <p>Each claim names its evidence and the release it was last checked against.</p>
      </div>
      <ul class="trust-rows">
        {trust.map((item) => (
          <li data-trust-row={item.id}>
            <p class="trust-claim">
              {item.claim}
              {item.verdict && <span class="trust-verdict"> {item.verdict}.</span>}
            </p>
            <p class="trust-evidence">
              <span class="trust-label">Evidence</span>
              {item.evidence}: <a href={item.href}>{item.label}</a>
            </p>
            <p class="trust-release">
              <span class="trust-label">Last verified</span>
              {item.verified}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section delegation" aria-labelledby="delegation-title">
    <div class="shell">
      <h2 class="section-title chapter-title" id="delegation-title">Hand off the work. Keep the controls.</h2>
      <div class="feature">
        <div class="feature-copy">
          <h3>Delegate a goal, not a prompt.</h3>
          <p>
            A goal loop plans, works cycle by cycle under a deterministic supervisor, and reports
            against the goal. It runs without constant prompting, and never behind a spinner.
          </p>
          <ul class="proof-list">
            <li><CirclePause size={19} aria-hidden="true" /> Pause, nudge, or stop a loop</li>
            <li><Workflow size={19} aria-hidden="true" /> Inspect every cycle and result</li>
          </ul>
        </div>
        <div class="feature-media">
          <DeferredCapture
            src={loopsCapture}
            alt="A finished PersonalClaw goal loop with its cycle, time, spend, and the deliverable it reported"
            sizes="(max-width: 900px) 92vw, 58vw"
          />
        </div>
      </div>
      <div class="feature feature-flip">
        <div class="feature-copy">
          <h3>Approve from the keyboard.</h3>
          <p>
            When an agent wants a tool that needs your say, the request waits in the chat and in
            your inbox. <kbd>Cmd</kbd> <kbd>Enter</kbd> (<kbd>Ctrl</kbd> <kbd>Enter</kbd> off a Mac)
            approves the request that has keyboard focus. A delete, a change outside the chat's folder, a send to other people, spending, or a
            tool that doesn't say what it does asks once more first.
          </p>
          <a class="text-link" href="/docs/guides/keyboard">Every key, in the keyboard guide</a>
        </div>
        <div class="feature-media">
          <DeferredCapture
            src={inboxCapture}
            alt="The PersonalClaw inbox with a loop waiting on an answer and an agent request waiting on an approval"
            sizes="(max-width: 900px) 92vw, 58vw"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section boundary" aria-labelledby="boundary-title">
    <div class="shell">
      <div class="chapter-head">
        <h2 class="section-title" id="boundary-title">Your state stays home.</h2>
        <p>
          Everything PersonalClaw keeps lives in one folder on your machine. A model, a search
          engine or a channel is reached through something you add.
        </p>
      </div>
      <figure class="boundary-map">
        <div class="boundary-home" role="group" aria-labelledby="boundary-home-title">
          <p class="boundary-title" id="boundary-home-title">
            On your machine: <code>~/.personalclaw</code>
          </p>
          <ul class="boundary-domains">
            {homeDomains.map((domain) => (
              <li>
                <span class="domain-name">{domain.name}</span>
                <span class="domain-stores">{domain.stores.join(", ")}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="boundary-edge" aria-hidden="true"></div>
        <div class="boundary-out" role="group" aria-labelledby="boundary-out-title">
          <p class="boundary-title" id="boundary-out-title">Across the network, when you add it</p>
          <ul class="boundary-apps">
            <li>A model provider app you bind</li>
            <li>A search provider app you bind</li>
            <li>A channel app you connect</li>
            <li>An MCP server you add</li>
          </ul>
          <p class="boundary-note">
            The one call it makes on its own, the update check, is on{" "}
            <a href="/compare#telemetry">/compare</a>, with how to turn it off.
          </p>
        </div>
        <figcaption>
          The domains and stores are core's own list, from{" "}
          <a href={inventoryUrl}>durability/inventory.py</a> at {core.source.tag ?? core.source.shortCommit}. A snapshot is made of
          exactly these domains.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section apps-security" aria-labelledby="apps-title">
    <div class="shell">
      <div class="chapter-head">
        <h2 class="section-title" id="apps-title">Every vendor is an app.</h2>
        <p>
          Models, search, speech, channels, tools and agent runtimes are apps you install and
          uninstall, each one a bundle with its own permissions.{" "}
          {releaseFacts.apps.total} first-party apps ship at this release.
        </p>
      </div>
      <ul class="app-belt" aria-label="App categories">
        {categories.map((category) => (
          <li>
            <a href={`/apps?category=${category.name.toLowerCase()}`}>
              {category.name} <span class="belt-count">{category.apps}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="build-on">
        <div class="build-copy">
          <h3>Build on it.</h3>
          <p>
            An app is a folder with an <code>app.json</code>. When someone installs it, it lands in
            quarantine, a scan gives it a verdict, and it waits for their consent before it runs.
          </p>
          <a class="text-link" href={appGuideUrl}>The app creation guide</a>
        </div>
        <figure class="build-snippet">
          <figcaption>{BUILDERS_SNIPPET.path}, a first-party app at the pinned apps commit</figcaption>
          <pre tabindex="0" aria-label={`${BUILDERS_SNIPPET.path}`}><code>{BUILDERS_SNIPPET.text}</code></pre>
        </figure>
      </div>
      <div class="security-note">
        <ShieldCheck size={22} aria-hidden="true" />
        <p>
          The model proposes; deterministic controls outside it decide what reaches your shell,
          your network and your apps. An app gets a scoped gateway token, and its own code still
          runs as you. <a href="/security">How the boundary holds</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section maturity" aria-labelledby="maturity-title">
    <div class="shell maturity-layout">
      <div class="maturity-copy">
        <h2 class="section-title" id="maturity-title">Early, and honest about it.</h2>
        <p>
          PersonalClaw is pre-1.0: a release can change how your data is stored, with no automatic
          migration. Run <code>personalclaw snapshot</code> before you update, and{" "}
          <code>personalclaw restore</code> brings it back.{" "}
          <a href="/compare">What holds and what doesn't, row by row</a>
        </p>
        <h3>The latest releases</h3>
        <ol class="releases">
          {latest.map((release) => (
            <li>
              <p class="release-head">
                <a href={`${core.source.repositoryUrl}/releases/tag/v${release.heading}`}>v{release.heading}</a>
                <time datetime={release.date}>{release.date}</time>
              </p>
              <p class="release-summary">{release.summary}</p>
            </li>
          ))}
        </ol>
      </div>
      <div class="faq" id="faq">
        <h3>Questions</h3>
        {questions.map((question) => (
          <details data-faq={question.id}>
            <summary>{question.question}</summary>
            {question.answer.map((paragraph) => (
              <p data-faq-answer>
                {paragraph.map((segment) =>
                  typeof segment === "string" ? segment : "code" in segment ? <code>{segment.code}</code> : <kbd>{segment.kbd}</kbd>
                )}
              </p>
            ))}
            <p>
              {question.links.map((link, index) => (
                <>
                  {index > 0 && " and "}
                  <a href={link.href}>{link.label}</a>
                </>
              ))}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="closing" aria-labelledby="closing-title">
    <div class="shell closing-inner">
      <h2 class="section-title" id="closing-title">Run it on your machine.</h2>
      <div class="closing-actions">
        <button class="button button-primary closing-cta" type="button" popovertarget={INSTALL_PANEL_ID}>
          Install PersonalClaw
        </button>
        <a class="closing-docs" href="/docs">Read the docs</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Direction A (#87, DESIGN.md "Home's first viewport"): the proposition on the coral
     field, and the System Window hanging across the field's lower edge into the dark
     theater, so the brand and the product proof share the first screen. --hero-overlap
     is how far the window reaches past the coral; the theater's top padding returns it. */
  .home-hero,
  .trust {
    --hero-overlap: clamp(6.5rem, 13vw, 12.5rem);
  }

  .home-hero {
    background: var(--theater);
  }

  .hero-field {
    padding-top: clamp(2rem, 4vw, 3.5rem);
    background: var(--coral);
    color: var(--coral-ink);
  }

  .hero-field .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 7fr);
    gap: clamp(2rem, 4vw, 4.5rem);
    align-items: center;
  }

  /* Text and focus on coral are dark ink, never white or coral (5.8:1). */
  .hero-field :focus-visible {
    outline-color: var(--coral-ink);
  }

  /* The wordmark is one word that must not break: the display role, capped by the copy
     column (the word is about 6em wide in DM Sans 300), so it fits at every width. */
  .hero-copy {
    --hero-display: min(var(--fs-display), 16cqi);
    container-type: inline-size;
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .hero-mark {
    display: block;
    width: 52px;
    height: 52px;
    margin-bottom: 1.4rem;
    background: var(--coral-ink);
    mask: url("/brand/personalclaw-mark.svg") center / contain no-repeat;
  }

  h1 {
    margin-bottom: 0.45rem;
    color: var(--coral-ink);
    font-size: var(--hero-display);
  }

  /* Three lines, broken where the sentences end rather than by a measure in ch, which split
     "One agentic OS." on a phone. */
  .hero-line {
    margin-bottom: 1.2rem;
    font-size: clamp(1.45rem, 2.7vw, 2.45rem);
    font-weight: 520;
    line-height: 1.08;
  }

  .hero-support {
    max-width: 30rem;
    margin-bottom: 1.75rem;
    font-size: 1.08rem;
    font-weight: 450;
  }

  .hero-actions {
    display: flex;
    gap: 0.5rem 1.4rem;
    align-items: center;
    flex-wrap: wrap;
  }

  /* The coral button would vanish on the coral field: here the primary action is the
     field's own ink, with coral type (5.8:1, and 5.8:1 between the pill and the field). */
  .hero-cta {
    background: var(--coral-ink);
    color: var(--coral);
  }

  .hero-cta:hover {
    background: var(--night);
    color: var(--coral-bright);
  }

  .hero-tour-link {
    display: inline-flex;
    min-height: 44px;
    gap: 0.45rem;
    align-items: center;
    color: var(--coral-ink);
    font-size: var(--fs-label);
    font-weight: 650;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .hero-tour-link:hover {
    text-decoration-thickness: 2px;
  }

  .hero-window {
    position: relative;
    z-index: 1;
    align-self: end;
    margin-bottom: calc(-1 * var(--hero-overlap));
    animation: window-arrive 650ms 120ms both cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero-window :global(.system-window) {
    box-shadow: 0 32px 80px color-mix(in srgb, var(--coral-ink) 45%, transparent);
  }

  /* The trust chapter starts on the theater the window lands in: its heading sits beside the
     window's lower half on desktop, and the rows begin below the window (see .trust). */


  /* The chapters below the hero: each opens with its heading and one sentence, then one
     dominant piece of proof. No kickers, no numbered labels, no cards. */
  /* Heading over its one sentence, never a headline with a small explainer beside it. */
  .chapter-head {
    display: grid;
    max-width: 52rem;
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .chapter-head h2,
  .chapter-title {
    margin: 0;
  }

  .chapter-title {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .chapter-head p {
    max-width: 34rem;
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.08rem;
  }

  .text-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--coral-bright);
    font-weight: 650;
  }

  .text-link:hover {
    color: var(--ink);
  }

  /* Chapter 1, the proof: a claim, its evidence, the release it was checked at, on the
     theater the window lands in. */
  .trust {
    padding-top: clamp(2.5rem, 4vw, 3.5rem);
    background: var(--theater);
  }

  /* Beside the window on desktop: the heading keeps to the copy's column, and the head is
     taller than the window's overhang, so the rows clear it. */
  .trust .chapter-head {
    max-width: min(46%, 36rem);
    min-height: var(--hero-overlap);
  }

  .trust-rows {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .trust-rows li {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 0.55fr);
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 1.15rem;
    border-bottom: 1px solid var(--line);
  }

  .trust-rows p {
    margin: 0;
  }

  .trust-claim {
    color: var(--ink);
    font-size: 1.08rem;
  }

  .trust-verdict {
    color: var(--ink-soft);
    font-weight: 600;
  }

  .trust-evidence,
  .trust-release {
    color: var(--ink-soft);
  }

  .trust-label {
    display: block;
    color: var(--ink-muted);
    font-size: var(--fs-label);
  }

  /* Chapter 2: capture and text, alternating. */
  .delegation {
    background: var(--night-soft);
  }

  .feature {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  .feature + .feature {
    margin-top: clamp(4rem, 8vw, 7rem);
  }

  .feature-flip {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
  }

  .feature-flip .feature-copy {
    order: 2;
  }

  .feature-copy h3 {
    margin-bottom: 1rem;
    font-size: var(--fs-title);
    font-weight: var(--fw-title);
    line-height: var(--lh-title);
  }

  .feature-copy > p {
    max-width: 34rem;
    color: var(--ink-soft);
    font-size: 1.08rem;
  }

  .feature-copy kbd {
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    background: var(--theater-high);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
  }

  .feature-media :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
  }

  .proof-list {
    display: grid;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .proof-list li {
    display: flex;
    min-height: 48px;
    gap: 0.75rem;
    align-items: center;
    border-bottom: 1px solid var(--line);
    color: var(--ink-soft);
  }

  .proof-list svg {
    color: var(--ink-muted);
  }

  /* Chapter 3: the boundary, drawn in HTML so its words stay text. */
  .boundary-map {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) auto minmax(0, 1fr);
    margin: 0;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: stretch;
  }

  .boundary-home,
  .boundary-out {
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: 8px;
  }

  .boundary-home {
    border: 1px solid var(--line-strong);
    background: var(--theater);
  }

  .boundary-out {
    border: 1px dashed var(--line-strong);
  }

  .boundary-title {
    margin-bottom: 1.25rem;
    color: var(--ink);
    font-weight: 650;
  }

  .boundary-domains {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(12rem, 100%), 1fr));
    margin: 0;
    padding: 0;
    gap: 1rem 1.5rem;
    list-style: none;
  }

  .boundary-domains li {
    display: grid;
    align-content: start;
    gap: 0.2rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
  }

  .domain-name {
    color: var(--ink);
    font-weight: 600;
  }

  .domain-stores {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
  }

  /* The edge of the machine: the one line everything outside has to cross. */
  .boundary-edge {
    width: 2px;
    background: var(--line-strong);
  }

  .boundary-apps {
    display: grid;
    margin: 0 0 1.25rem;
    padding: 0;
    gap: 0.6rem;
    color: var(--ink-soft);
    list-style: none;
  }

  .boundary-note,
  .boundary-map figcaption {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--fs-label);
  }

  .boundary-map figcaption {
    grid-column: 1 / -1;
  }

  /* Links inside running text keep a 44 px target, like every control on the site. */
  .trust-evidence a,
  .boundary-note a,
  .boundary-map figcaption a,
  .security-note a,
  .maturity-copy a,
  .faq a {
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    color: var(--coral-bright);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    vertical-align: middle;
  }

  /* Chapter 4: apps and security. */
  .apps-security {
    background: var(--night-soft);
  }

  .app-belt {
    display: flex;
    margin: 0 0 clamp(3rem, 6vw, 5rem);
    padding: 0;
    gap: 0.6rem;
    flex-wrap: wrap;
    list-style: none;
  }

  .app-belt a {
    display: inline-flex;
    min-height: 44px;
    padding: 0.5rem 1rem;
    gap: 0.6rem;
    align-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink);
    font-weight: 600;
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .app-belt a:hover {
    border-color: var(--ink-muted);
    background: var(--theater-high);
  }

  .belt-count {
    color: var(--ink-muted);
    font-weight: 500;
  }

  .build-on {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .build-copy h3 {
    margin-bottom: 1rem;
    font-size: var(--fs-title);
    font-weight: var(--fw-title);
    line-height: var(--lh-title);
  }

  .build-copy p {
