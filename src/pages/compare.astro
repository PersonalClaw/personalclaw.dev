---
import BaseLayout from "../layouts/BaseLayout.astro";
import { GITHUB_URL } from "../data/site";
import { capabilityMatrix, verdictPresentation } from "../data/capabilities.mjs";

// One normalizer, shared with scripts/validate-compare-render.mjs. See the header of
// src/data/capabilities.mjs for why an unsourced row cannot reach this page, and why a row not
// verified at the pinned release reaches it only as a known limit.
const { groups, counts, current, knownLimits, release, verdicts, checkedOn, problems } =
  capabilityMatrix();

// Worst-last is deliberate: the legend and the headline counts both read yes -> partial ->
// no, so a reader meets the failures in the same order every time rather than by scroll
// position.
const order = ["yes", "partial", "no"] as const;
const notClean = counts.partial + counts.no;
---

<BaseLayout
  title="What it does · PersonalClaw"
  description="A row-by-row account of what PersonalClaw does and does not do at its released version, with every row citing the file it was checked against."
>
  <section class="caps">
    <div class="shell">
      <h1 class="section-title">Every row checked against the release, including the ones that fail</h1>

      <p class="lede" data-support>
        Every row below names the file it was verified against in{" "}
        <span translate="no">{release.version}</span>, the release this website publishes,
        pinned at <span translate="no">{release.commit.slice(0, 8)}</span>.
      </p>

      <p class="lede">
        Feature lists are written to be believed. This one is written to be checked, against
        the release and not core's development branch, where more is true. Checked on{" "}
        <time datetime={checkedOn}>{checkedOn}</time>.
      </p>

      {/* Counted from the rows, never typed (SITE-REDESIGN.md section 6). */}
      <p class="lede" data-capability-counts>
        Of the {current.length} rows,{" "}
        <span data-capability-count="yes">{counts.yes}</span> hold,{" "}
        <span data-capability-count="partial">{counts.partial}</span> are narrower than they
        sound and <span data-capability-count="no">{counts.no}</span> are not in this release,
        so {notClean} are not a clean pass. That is the point of the page: a claim stated wider
        than the release supports is the failure this project keeps finding in its own drafts,
        so the narrower truth is written out in full rather than rounded up.
      </p>

      <section class="legend" aria-labelledby="how-to-read" data-capability-legend>
        <h2 id="how-to-read">How to read a verdict</h2>
        <dl>
          {order.map((verdict) => {
            const shown = verdictPresentation(verdict);
            return (
              <div data-capability-legend-item={verdict}>
                <dt>
                  <span class:list={["verdict", shown.tone]}>{shown.label}</span>
                </dt>
                <dd>{verdicts[verdict]?.meaning ?? ""}</dd>
              </div>
            );
          })}
        </dl>
      </section>

      {/*
        The filter shows one group at a time and keeps it in `?group=`, the way /apps keeps its
        category. It is hidden until the script below wires it, so without JavaScript the page
        stays whole: every group, every row.
      */}
      <div class="filter" role="group" aria-label="Show rows about" data-compare-filter hidden>
        <button type="button" aria-pressed="true" data-compare-group="">All</button>
        {groups.map((group) => (
          <button type="button" aria-pressed="false" data-compare-group={group.id}>
            {group.short}
          </button>
        ))}
      </div>

      {groups.map((group) => (
        <section class="group" aria-labelledby={`group-${group.id}`} data-capability-group={group.id}>
          <h2 id={`group-${group.id}`}>{group.label}</h2>
          <p class="group-blurb">{group.blurb}</p>

          <ul class="rows">
            {group.rows.map((row) => {
              const shown = verdictPresentation(row.verdict);
              // The row's capability key, never its position, so /compare#telemetry keeps
              // reaching its row (scripts/compare-row-ids.mjs).
              return (
                <li
                  class="row"
                  id={row.id}
                  data-capability-row={row.id}
                  data-capability-verdict={row.verdict}
                >
                  <p class:list={["verdict", shown.tone]}>{shown.label}</p>
                  <h3 data-capability-claim>{row.claim}</h3>
                  <p class="statement" data-capability-statement>{row.statement}</p>
                  <a
                    class="source"
                    data-capability-source
                    href={row.sourceUrl}
                    target="_blank"
                    rel="noreferrer"
                  >
                    <span translate="no">{row.sourceLabel}</span>{" "}
                    <span class="source-at">
                      at <span translate="no">{row.verifiedRelease}</span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))}

      {knownLimits.length > 0 && (
        <section class="group" aria-labelledby="not-rechecked" data-capability-limits>
          <h2 id="not-rechecked">Not checked again at <span translate="no">{release.version}</span></h2>
          <p class="group-blurb">
            These were last verified at an earlier release. Each shows the wording and the evidence
            from that check, and none is a claim about this release until it is read again.
          </p>
          <ul class="rows">
            {/* #98's settled form: "Not re-checked for <pinned release>:", then the statement the
                row was last verified with, then that statement's evidence link, so the old wording
                never reads as current (scripts/validate-compare-render.mjs holds it). */}
            {knownLimits.map((row) => (
              <li class="row" id={row.id} data-capability-limit={row.id}>
                <p class="statement">
                  <strong>Not re-checked for <span translate="no">{release.version}</span>:</strong>{" "}
                  {row.statement}
                </p>
                <a class="source" href={row.sourceUrl} target="_blank" rel="noreferrer">
                  <span translate="no">{row.sourceLabel}</span>{" "}
                  <span class="source-at">
                    at <span translate="no">{row.verifiedRelease}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {problems.length > 0 && (
        <p class="problems">
          {problems.length} recorded row{problems.length === 1 ? "" : "s"} could not be
          rendered because {problems.length === 1 ? "it was" : "they were"} incomplete, and
          {problems.length === 1 ? " is" : " are"} named in the build output rather than
          shown here as a fact.
        </p>
      )}

      <section class="closing" aria-labelledby="check-it">
        <h2 id="check-it">Check it yourself</h2>
        <p class="lede">
          Every link above points into the tagged release, so a row is falsifiable in one
          step: open the file and read it. If a row overstates what the code does, that is a
          defect in this page and it will be fixed or the row will be removed.
        </p>
        <p class="lede">
          What this page does not do is compare PersonalClaw to other projects. Doing that
          responsibly means auditing somebody else's software to the same standard applied
          here, and this project has not earned that standing while it is still finding
          overstatements in its own drafts. An accurate account of our own scope is more
          useful to you than our characterisation of anyone else's.
        </p>
        <p class="lede">
          The controls behind the autonomy rows are written up in full elsewhere, including
          a limitations page that exists for the same reason this one does.
        </p>

        <ul class="next-links">
          <li>
            <a class="text-link" href="/security">The security posture</a>
          </li>
          <li>
            <a class="text-link" href="/docs/security/limitations">Known limitations</a>
          </li>
        </ul>
      </section>

      <p class="provenance">
        Read from <span translate="no">{release.version}</span>{" "}
        (<span translate="no">{release.commit.slice(0, 12)}</span>) · checked{" "}
        <time datetime={checkedOn}>{checkedOn}</time>
      </p>

      <p class="correction">
        If a row here is wrong or has gone stale, say so and it will be corrected or the row
        will be removed.
      </p>
      <a
        class="text-link"
        href={`${GITHUB_URL}/issues`}
        target="_blank"
        rel="noreferrer"
      >
        Open an issue
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  // ?group= is the filter's state, as ?category= is on /apps: a copied link, a reload, Back and
  // Forward all show the same group. An unknown group shows everything.
  const filter = document.querySelector<HTMLElement>("[data-compare-filter]");
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-compare-group]")];
  const sections = [...document.querySelectorAll<HTMLElement>("[data-capability-group]")];
  const known = new Set(sections.map((section) => section.dataset.capabilityGroup));

  const show = (group: string) => {
    const chosen = known.has(group) ? group : "";
    for (const button of buttons) {
      button.setAttribute("aria-pressed", String(button.dataset.compareGroup === chosen));
    }
    for (const section of sections) {
      section.hidden = chosen !== "" && section.dataset.capabilityGroup !== chosen;
    }
    return chosen;
  };

  if (filter) {
    filter.hidden = false;
    show(new URLSearchParams(location.search).get("group") ?? "");
    for (const button of buttons) {
      button.addEventListener("click", () => {
        const chosen = show(button.dataset.compareGroup ?? "");
        const url = new URL(location.href);
        if (chosen) url.searchParams.set("group", chosen);
        else url.searchParams.delete("group");
        history.pushState({}, "", url);
      });
    }
    window.addEventListener("popstate", () => {
      show(new URLSearchParams(location.search).get("group") ?? "");
    });
  }
</script>

<style>
  .caps {
    padding: clamp(4rem, 8vw, 7rem) 0 clamp(6rem, 10vw, 9rem);
  }

  h1 {
    max-width: 30ch;
    margin: 0.5rem 0 1.6rem;
  }

  h2 {
    margin: 0 0 0.7rem;
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 500;
  }

  h3 {
    margin: 0 0 0.5rem;
    max-width: 62ch;
    font-size: 1.06rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .lede {
    margin: 0 0 1.2rem;
    max-width: 70ch;
    color: var(--ink-soft);
    font-size: var(--fs-body);
    line-height: 1.7;
  }

  .legend,
  .group,
  .closing {
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .legend dl {
    display: grid;
    margin: 1.4rem 0 0;
    gap: 1rem;
  }

  .legend dt {
    margin-bottom: 0.3rem;
  }

  .legend dd {
    margin: 0;
    max-width: 70ch;
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .verdict {
    display: inline-flex;
    margin: 0;
    padding: 0.22rem 0.6rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
  }

  .verdict-yes {
    border-color: var(--success);
    color: var(--success);
  }

  /* Coral, because a narrowed claim is the row a reader most needs to stop on. DESIGN.md
     reserves coral for active attention rather than decoration, and this is exactly that. */
  .verdict-partial {
    border-color: var(--coral-bright);
    color: var(--coral-bright);
  }

  /* Solid and plain, never dashed: "not in this release" is a settled fact, not an
     uncertainty. */
  .verdict-no {
    border-color: var(--line-strong);
    background: var(--theater-high);
    color: var(--ink);
  }

  /* The filter: one pill per group, wrapping rather than scrolling. The pressed one is coral
     with night text, as the selected category on /apps is. */
  .filter {
    display: flex;
    margin: clamp(3rem, 7vw, 5rem) 0 0;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .filter[hidden] {
    display: none;
  }

  .filter button {
    min-height: 44px;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
    font-size: var(--fs-label);
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .filter button:hover {
    background: var(--theater-high);
    color: var(--ink);
  }

  .filter button[aria-pressed="true"] {
    border-color: var(--coral);
    background: var(--coral);
    color: var(--night);
    font-weight: 650;
  }

  /* Forced colours drop the coral fill; an outline and underline keep the pressed group. */
  @media (forced-colors: active) {
    .filter button[aria-pressed="true"] {
      outline: 2px solid Highlight;
      outline-offset: -2px;
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 0.25em;
    }
  }

  .group[hidden] {
    display: none;
  }

  .group-blurb {
    margin: 0;
    max-width: 70ch;
    color: var(--ink-muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .rows {
    display: grid;
    margin: clamp(1.6rem, 4vw, 2.2rem) 0 0;
    padding: 0;
    gap: 1rem;
    list-style: none;
  }

  .row {
    padding: 1.3rem;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
  }

  .row .verdict {
    margin-bottom: 0.7rem;
  }

  .statement {
    margin: 0 0 0.9rem;
    max-width: 74ch;
    color: var(--ink-soft);
    font-size: 0.93rem;
    line-height: 1.7;
  }

  .source {
    display: inline-flex;
    min-height: 44px;
    gap: 0.4rem;
    align-items: center;
    /* Both of these are load-bearing at 320px. The labels are real repository paths -
       `docs/architecture/provider-boundary.md` is the longest - and a monospace path is one unbreakable
       token, so without a wrap the flex row runs past the card and takes the page with it. */
    flex-wrap: wrap;
    color: var(--coral-bright);
    font-weight: 650;
    font-size: 0.85rem;
  }

  .source span[translate="no"] {
    font-family: var(--font-mono);
    overflow-wrap: anywhere;
  }

  .source-at {
    color: var(--ink-muted);
    font-family: inherit;
    font-weight: 400;
  }

  .problems {
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    max-width: 70ch;
    color: var(--ink-muted);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  /* Standalone, never mid-sentence. `.text-link` is declared per page across this site
     (see src/pages/release.astro) and every link on it is inline-flex with a 44px minimum,
     so a link inside a running paragraph would be the one shape that cannot satisfy the
     touch-target contract without wrecking the line box. The prose above was rewritten to
     end in these instead. */
  .text-link {
    display: inline-flex;
    min-height: 44px;
    gap: 0.45rem;
    align-items: center;
    color: var(--coral-bright);
    font-weight: 650;
  }

  .text-link:hover {
    color: var(--ink);
  }

  .next-links {
    display: flex;
    margin: 0.4rem 0 0;
    padding: 0;
    gap: clamp(1rem, 4vw, 2.5rem);
    flex-wrap: wrap;
    list-style: none;
  }

  .provenance {
    margin: clamp(3rem, 7vw, 5rem) 0 0;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    line-height: 1.9;
  }

  .correction {
    margin: 1.2rem 0 0;
    max-width: 70ch;
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.7;
  }

</style>
