---
import { ArrowUpRight } from "lucide-react";
import BaseLayout from "../layouts/BaseLayout.astro";
import { registryListing } from "../data/registry.mjs";

// One read, at build time. The page is static and same-origin: nothing here is fetched
// in a reader's browser. See scripts/sync-registry.mjs for where the data comes from.
const listing = registryListing();
const { apps, problems, source, state } = listing;

const registryTreeUrl =
  state === "absent-at-pin"
    ? `https://github.com/${source.repository}/tree/main/${source.path.replace(/\/[^/]+$/, "")}`
    : `https://github.com/${source.repository}/tree/${source.commit}/${source.path.replace(/\/[^/]+$/, "")}`;

// The legend below explains the verdict vocabulary. It is deliberately labelled as a
// legend rather than dressed up as data: with no listings to show, a page that looked
// populated would be the dishonest version of an empty registry.
const verdictLegend = [
  {
    label: "Clean",
    tone: "pass",
    detail: "The last recorded scan found nothing."
  },
  {
    label: "Low / Warning",
    tone: "caution",
    detail: "The last recorded scan raised findings worth reading first."
  },
  {
    label: "Dangerous",
    tone: "blocked",
    detail: "The last recorded scan found dangerous behaviour. Such listings are removed."
  },
  {
    label: "No scan on record",
    tone: "unscanned",
    detail: "No verdict has been recorded. Unscanned is not the same as clean."
  }
];
---

<BaseLayout
  title="Community registry · PersonalClaw"
  description="Browse community PersonalClaw apps with the permissions each one declares and the verdict of its last supply-chain scan, before installing anything."
>
  <section class="registry-hero">
    <div class="shell registry-intro">
      <div>
        <p class="kicker">Community registry</p>
        <h1>See what an app asks for, first.</h1>
      </div>
      <div class="intro-copy">
        <p>
          Every listing publishes the permissions its manifest declares and the
          verdict of its last supply-chain scan. Both appear here unchanged, so the
          decision happens before any code reaches your machine.
        </p>
        <a class="text-link" href={registryTreeUrl} target="_blank" rel="noreferrer">
          Read the registry and its listing policy
          <ArrowUpRight size={17} aria-hidden="true" />
        </a>
      </div>
    </div>

    <p class="shell registry-provenance">
      Generated from <span translate="no">{source.repository}</span>
      {source.tag ? ` ${source.tag}` : ""} · <span translate="no">{source.path}</span>
    </p>
  </section>

  <section class="section-rule registry-listings">
    <div class="shell">
      {state === "listed" && (
        <>
          <p class="result-count">
            {apps.length} {apps.length === 1 ? "listing" : "listings"}
          </p>
          <div class="app-grid registry-grid">
            {apps.map((app) => (
              <a class="app-card registry-card" href={app.path}>
                <div class="app-card-head">
                  <span class="app-category">{app.types.join(" · ")}</span>
                  <ArrowUpRight size={18} aria-hidden="true" />
                </div>
                <h3>{app.name}</h3>

                <p class:list={["registry-verdict", `verdict-${app.verdict.tone}`]}>
                  <span>{app.verdict.label}</span>
                </p>

                <div class="registry-permissions">
                  <span class="registry-field-label">Declared permissions</span>
                  {app.permissions.length > 0 ? (
                    <ul aria-label={`Permissions ${app.name} declares`}>
                      {app.permissions.map((permission) => (
                        <li translate="no">{permission}</li>
                      ))}
                    </ul>
                  ) : (
                    <p class="registry-none">None declared</p>
                  )}
                </div>

                <dl class="registry-meta">
                  <div>
                    <dt>Maintainer</dt>
                    <dd translate="no">{app.maintainer}</dd>
                  </div>
                  <div>
                    <dt>License</dt>
                    <dd translate="no">{app.license}</dd>
                  </div>
                </dl>
              </a>
            ))}
          </div>
        </>
      )}

      {state === "empty" && (
        <div class="registry-notice">
          <h2>The registry is open and lists no applications yet.</h2>
          <p>
            The registry exists in this release and currently contains zero listings.
            Nothing has been accepted into it so far.
          </p>
        </div>
      )}

      {state === "absent-at-pin" && (
        <div class="registry-notice">
          <h2>The registry is not part of this release yet.</h2>
          <p>
            This website is generated from a pinned PersonalClaw release, and the
            community registry landed after it. There is no registry file to read at
            <span translate="no"> {source.repository} {source.tag ?? source.commit}</span>,
            so no listings are published here. This page begins showing them when the
            site is regenerated from a release that contains the registry.
          </p>
        </div>
      )}

      {problems.length > 0 && (
        <div class="registry-problems" role="group" aria-label="Registry entries that could not be read">
          <h2>
            {problems.length} {problems.length === 1 ? "entry" : "entries"} could not be read
          </h2>
          <p>
            These entries exist in the registry but are not shown above, because this
            site could not read them well enough to state what they ask for.
          </p>
          <ul>
            {problems.map((problem) => (
              <li>{problem.reason}</li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <section class="section registry-legend-section section-rule">
    <div class="shell">
      <div class="section-head">
        <div>
          <p class="kicker">How to read a listing</p>
          <h2>A verdict is a record, not a promise.</h2>
        </div>
        <p>
          The registry records what the last scan found, and when. Most listings carry
          no verdict at all, because a scan is recorded by the registry's own checks
          rather than claimed by the author.
        </p>
      </div>

      <dl class="registry-legend">
        {verdictLegend.map((item) => (
          <div>
            <dt>
              <span class:list={["registry-verdict", `verdict-${item.tone}`]}>
                <span>{item.label}</span>
              </span>
            </dt>
            <dd>{item.detail}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .registry-hero {
    padding: clamp(5rem, 10vw, 9rem) 0 0;
  }

  .registry-intro {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(3rem, 10vw, 10rem);
    align-items: end;
  }

  h1 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(3.5rem, 8vw, 7.5rem);
    font-weight: 330;
    line-height: 0.94;
  }

  .intro-copy > p {
    color: var(--ink-soft);
    font-size: 1.15rem;
  }

  /* `.text-link` is declared per page across this site (index, product, apps, release);
     these are apps.astro's declarations verbatim. Promoting it into global.css would be
     a genuine coherence win and a five-page pixel change, so it is not done here. */
  .text-link {
    display: inline-flex;
    min-height: 44px;
    gap: 0.45rem;
    align-items: center;
    color: var(--coral-bright);
    font-weight: 650;
  }

  .registry-provenance {
    margin: clamp(3rem, 7vw, 5rem) 0 0;
    padding-bottom: 1.25rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .registry-listings {
    padding: 0 0 clamp(6rem, 10vw, 9rem);
  }

  .registry-card h3 {
    margin: 1.9rem 0 1rem;
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.15;
  }

  /* The verdict badge. Four treatments, because "no scan on record" reading as mildly
     as "clean" is the failure this page exists to prevent. Green is the only reassuring
     one; an absent verdict is a dashed outline, which cannot be mistaken for a pass. */
  .registry-verdict {
    display: inline-flex;
    /* The card is a flex column, so a badge left to `align-items: stretch` spans the
       whole card and stops reading as a badge. */
    align-self: flex-start;
    margin: 0 0 1.35rem;
    padding: 0.28rem 0.62rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .verdict-pass {
    border-color: var(--success);
    color: var(--success);
  }

  .verdict-caution {
    border-color: var(--line-strong);
    background: var(--surface-high);
    color: var(--ink);
  }

  .verdict-blocked {
    border-color: var(--ember);
    background: var(--ember);
    color: var(--ink);
  }

  .verdict-unscanned {
    border-style: dashed;
  }

  .registry-field-label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
  }

  .registry-permissions ul {
    display: flex;
    margin: 0;
    padding: 0;
    gap: 0.4rem;
    flex-wrap: wrap;
    list-style: none;
  }

  .registry-permissions li {
    padding: 0.25rem 0.48rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .registry-none {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }

  .registry-meta {
    display: grid;
    margin: auto 0 0;
    padding-top: 1.5rem;
    gap: 0.3rem;
  }

  .registry-meta div {
    display: flex;
    gap: 0.6rem;
    justify-content: space-between;
  }

  .registry-meta dt {
    color: var(--ink-muted);
    font-size: 0.78rem;
  }

  .registry-meta dd {
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .registry-notice,
  .registry-problems {
    padding: clamp(2.5rem, 6vw, 4rem) 0 0;
  }

  /* Measure is constrained on the CONTENT, not on the container: `.registry-problems`
     carries a rule above it, and a rule that stops at 62ch reads as a rendering bug. */
  .registry-notice > *,
  .registry-problems > * {
    max-width: 62ch;
  }

  .registry-notice h2,
  .registry-problems h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    font-weight: 420;
    line-height: 1.1;
  }

  .registry-notice p,
  .registry-problems p {
    margin: 0;
    color: var(--ink-soft);
  }

  .registry-problems {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    border-top: 1px solid var(--line);
  }

  .registry-problems ul {
    margin: 1.1rem 0 0;
    padding-left: 1.2rem;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .registry-legend {
    display: grid;
    margin: 0;
    padding: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  .registry-legend > div {
    padding: 1.5rem 1.5rem 1.5rem 0;
    border-bottom: 1px solid var(--line);
  }

  .registry-legend dt {
    margin-bottom: 0.7rem;
  }

  .registry-legend dd {
    margin: 0;
    max-width: 44ch;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .registry-intro,
    .registry-legend {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    h1 {
      font-size: 3.6rem;
    }
  }
</style>
