---
import { Boxes, Check, Clock3, Code2, FileCheck2, GitCommit, Tag } from "lucide-react";
import BaseLayout from "../layouts/BaseLayout.astro";
import { CopyCommand } from "../components/CopyCommand";
import ReleaseClip from "../components/ReleaseClip.astro";
import { releaseFacts } from "../data/release";
import sourceManifest from "../../sources/personalclaw.sources.json";

const isReleased = releaseFacts.channel === "released";
const release = releaseFacts.core.release;
const generatedAt =
  `${releaseFacts.generatedAt.slice(0, 16).replace("T", " ")} UTC`;
const baselineHighlights =
  releaseFacts.core.changelog.currentVersion.sections.flatMap(
    (section) => section.items
  ).slice(0, 6);
const changelogUrl = `${releaseFacts.core.source.repositoryUrl}/blob/${releaseFacts.core.source.commit}/CHANGELOG.md`;
// Where a failed check goes: core's security policy at the pinned commit.
const securityPolicyUrl = `${releaseFacts.core.source.repositoryUrl}/blob/${releaseFacts.core.source.commit}/SECURITY.md`;

// The source manifest this build read, shown as it is rather than linked: a link into this
// repository's `main` can describe a later pin than the one that built the page (R5 in
// docs/site-audit.md).
const manifestText = JSON.stringify(sourceManifest, null, 2);

const megabytes = (bytes: number) =>
  bytes >= 1_000_000 ? `${(bytes / 1_000_000).toFixed(1)} MB` : `${Math.max(1, Math.round(bytes / 1000))} kB`;
const attested = release?.assets.filter((asset) => asset.attested) ?? [];
const sboms = release?.assets.filter((asset) => asset.sbom) ?? [];

// One string, so no line break in the markup can join a name to the version after it.
const describes =
  `This site describes PersonalClaw ${releaseFacts.core.versionLabel} and PersonalClawApps ` +
  `${releaseFacts.apps.source.tag ?? releaseFacts.apps.source.shortCommit}, and every product fact on it ` +
  "is built from their pinned revisions.";
---

<BaseLayout
  title="Release provenance · PersonalClaw"
  description="Trace the PersonalClaw version, changelog, app catalog, capabilities, and website claims to exact source commits."
>
  <section
    class="release-hero"
    data-release-provenance
    data-source-channel={releaseFacts.channel}
    data-content-schema={releaseFacts.schemaVersion}
    data-core-commit={releaseFacts.core.source.commit}
    data-apps-commit={releaseFacts.apps.source.commit}
    data-generated-at={releaseFacts.generatedAt}
  >
    <div class="shell release-hero-grid">
      <div class="release-heading">
        <h1 class="section-title">Know exactly what this site describes.</h1>
        <p class="release-lede" data-support>{describes}</p>
        <div class:list={["source-status", { "is-release": isReleased }]}>
          <Check size={18} aria-hidden="true" />
          <span>{releaseFacts.status.label}</span>
        </div>
      </div>

      {/* The top slot: the release in its own words, and its clip once one ships (#97). */}
      <ReleaseClip />
    </div>

    <div class="shell">
      <div class="snapshot-summary" aria-label="Pinned source summary">
        <dl>
          <div>
            <dt>Source channel</dt>
            <dd>{isReleased ? "Tagged release" : "Pre-release"}</dd>
          </div>
          <div>
            <dt>Core package</dt>
            <dd>{releaseFacts.core.versionLabel}</dd>
          </div>
          <div>
            <dt>App manifests</dt>
            <dd>{releaseFacts.apps.total}</dd>
          </div>
          <div>
            <dt>Content schema</dt>
            <dd>v{releaseFacts.schemaVersion}</dd>
          </div>
          <div>
            <dt>Build generated</dt>
            <dd data-build-time>{generatedAt}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  {
    release && (
      <section class="section verify-section section-rule" aria-labelledby="verify-title" id="verify" data-release-verify>
        <div class="shell">
          <div class="section-head">
            <h2 id="verify-title">Check the wheel before you install it.</h2>
            <p>
              Check the release you can download, then install the file you checked. The SHA-256
              is GitHub's record of the bytes uploaded to the release: core doesn't publish
              checksum files yet.
            </p>
          </div>

          {/* The one numbered list here, because the order is the check: download, compare,
              verify, then install that file. Every command is built from the pin
              (scripts/release-assets.mjs). */}
          <ol class="verify-steps">
            <li data-verify-step="download">
              <h3>Download the wheel</h3>
              <p>It saves <code>{release.steps.file}</code> in the current folder and runs nothing.</p>
              <CopyCommand command={release.steps.download} label="Download command" client:load />
            </li>
            <li data-verify-step="checksum">
              <h3>Compare its SHA-256</h3>
              <p>On macOS:</p>
              <CopyCommand command={release.steps.checksumMac} label="macOS checksum command" client:load />
              <p>On Linux:</p>
              <CopyCommand command={release.steps.checksumLinux} label="Linux checksum command" client:load />
              <p>
                It should print <code class="digest" data-verify-sha256>{release.steps.sha256}</code>.
                Anything else, delete the file and don't install it.
              </p>
            </li>
            <li data-verify-step="attestation">
              <h3>Verify where it was built</h3>
              <p>
                With the GitHub CLI, this checks the file's build provenance attestation: signed by
                core's release workflow, for the{" "}
                <span translate="no">{releaseFacts.core.source.tag}</span> tag, on a GitHub-hosted
                runner. It exits with 0 only when all three hold.
              </p>
              <CopyCommand command={release.steps.attestation} label="Attestation command" client:load />
              <p>
                If it exits with anything else, don't install the file, and report it privately
                through <a href={securityPolicyUrl}>core's security policy</a>.
              </p>
            </li>
            <li data-verify-step="install">
              <h3>Install the file you checked</h3>
              <p>
                It installs <code>{release.steps.file}</code> from this folder, with uv on the
                Python the installer uses, instead of fetching PersonalClaw again from PyPI.
              </p>
              <CopyCommand command={release.steps.install} label="Install command" client:load />
            </li>
          </ol>

          <div class="asset-table">
            {/* The label sits outside the table, and the roles keep it a table for assistive tech
                when phones stack its rows. */}
            <p class="asset-caption" id="release-assets-label">
              Every file attached to{" "}
              <a href={release.url} target="_blank" rel="noreferrer">
                <span translate="no">{releaseFacts.core.source.tag}</span>
              </a>
            </p>
            <table data-release-assets role="table" aria-labelledby="release-assets-label">
              <thead role="rowgroup">
                <tr role="row">
                  <th scope="col" role="columnheader">File</th>
                  <th scope="col" role="columnheader">Size</th>
                  <th scope="col" role="columnheader">SHA-256, as GitHub records it</th>
                  <th scope="col" role="columnheader">Evidence</th>
                </tr>
              </thead>
              <tbody role="rowgroup">
                {release.assets.map((asset) => (
                  <tr data-release-asset={asset.name} role="row">
                    <th scope="row" role="rowheader">
                      <a href={asset.url} translate="no">{asset.name}</a>
                    </th>
                    <td role="cell" data-label="Size">{megabytes(asset.size)}</td>
                    <td role="cell" data-label="SHA-256">
                      <code class="digest" data-asset-sha256>{asset.sha256}</code>
                    </td>
                    <td role="cell" data-label="Evidence">
                      {asset.sbom
                        ? "SBOM (SPDX)"
                        : asset.attested
                          ? "Build provenance attested"
                          : "Checksum only"}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <ul class="verify-limits">
            <li data-verify-limit="dependencies">
              This check covers PersonalClaw's own wheel. Its dependencies are resolved from PyPI
              when you install it, and nothing on this page checks them.
            </li>
            <li>
              Build provenance is attested for{" "}
              {attested.map((asset, index) => (
                <>
                  {index > 0 && " and "}
                  <code>{asset.name}</code>
                </>
              ))}
              . The other files carry GitHub's checksum alone.
            </li>
            <li>
              {sboms.length} SBOMs are attached, as SPDX JSON. Open one to see every package
              a build carries.
            </li>
            <li>
              The desktop installers are not signed by a publisher.{" "}
              <a href="/compare#desktop_app">What that means on each platform</a>
            </li>
          </ul>
        </div>
      </section>
    )
  }

  <section class="section source-section section-rule">
    <div class="shell">
      <div class="section-head">
        <h2>The commits this page was built from.</h2>
        <p>{releaseFacts.status.summary}</p>
      </div>

      <div class="source-ledger">
        {
          [
            { label: "Core", source: releaseFacts.core.source },
            { label: "First-party apps", source: releaseFacts.apps.source }
          ].map(({ label, source }) => (
            <article>
              <div class="source-name">
                <span>{label}</span>
                <h3>{source.repository.split("/")[0]}/<wbr />{source.repository.split("/")[1]}</h3>
              </div>
              <dl>
                <div>
                  <dt><GitCommit size={17} aria-hidden="true" /> Commit</dt>
                  <dd>
                    <a href={source.commitUrl} target="_blank" rel="noreferrer">
                      <code>{source.shortCommit}</code>
                    </a>
                  </dd>
                </div>
                <div>
                  <dt><Tag size={17} aria-hidden="true" /> Tag</dt>
                  <dd>
                    {source.tagUrl ? (
                      <a href={source.tagUrl} target="_blank" rel="noreferrer">
                        {source.tag}
                      </a>
                    ) : (
                      <span class="unverified">Not asserted</span>
                    )}
                  </dd>
                </div>
              </dl>
            </article>
          ))
        }
      </div>

      <details class="manifest-source">
        <summary>The source manifest this page was built from</summary>
        <pre tabindex="0" aria-label="sources/personalclaw.sources.json"><code>{manifestText}</code></pre>
      </details>

      {
        !isReleased && (
          <div class="release-caveat">
            <FileCheck2 size={22} aria-hidden="true" />
            <div>
              <strong>This is a development snapshot, not a release claim.</strong>
              <p>
                The package reports {releaseFacts.core.versionLabel}, but neither
                pinned repository has a verified tag in this manifest. A tagged
                website build must prove that every tag resolves to its declared
                commit before publication.
              </p>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <section class="section app-evidence section-rule">
    <div class="shell">
      <div class="section-head">
        <h2>The ecosystem count is computed, not typed.</h2>
        <p>
          Every number below is derived from the app manifests at the pinned
          PersonalClawApps commit. The website build fails if its public
          directory drifts from those names or categories.
        </p>
        <a
          class="text-link"
          href={`${releaseFacts.apps.source.repositoryUrl}/tree/${releaseFacts.apps.source.commit}/`}
        >
          The app manifests at the pinned commit
        </a>
      </div>

      <ul class="category-list" aria-label="Apps by category">
        {
          releaseFacts.apps.categories.map((category) => (
            <li>
              <span>{category.name}</span>{" "}
              <span class="category-apps">
                {category.apps} {category.apps === 1 ? "app" : "apps"}
              </span>
            </li>
          ))
        }
      </ul>

      <div class="capability-heading">
        <div>
          <Boxes size={22} aria-hidden="true" />
          <h3>{releaseFacts.apps.capabilityCount} declared capabilities</h3>
        </div>
        <p>Counted once per app manifest.</p>
      </div>
      <ul class="capability-ledger">
        {
          releaseFacts.apps.capabilities.map((capability) => (
            <li>
              <span>{capability.name}</span>{" "}
              <strong>{capability.apps}</strong>{" "}
              <small>{capability.apps === 1 ? "app" : "apps"}</small>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section change-section section-rule">
    <div class="shell change-grid">
      <div class="change-intro">
        <h2 class="section-title">Package baseline and work after it.</h2>
        <p>
          The release page reads the package version from <code>pyproject.toml</code>{" "}
          and locates the matching entry in the same pinned changelog.
        </p>
        <a
          class="text-link"
          href={changelogUrl}
          target="_blank"
          rel="noreferrer"
        >
          Read the pinned changelog
        </a>
      </div>

      <div class="change-entries">
        <article>
          <div class="entry-heading">
            <span>After the baseline</span>
            <h3>{releaseFacts.core.changelog.unreleased.heading}</h3>
          </div>
          {
            /* An empty Unreleased section is the NORMAL state of a freshly cut release, and
               it used to render as this heading followed by nothing — a blank panel that
               reads as a broken build rather than as a fact. The sibling article prints its
               summary; this one printed only its sections. Say the true thing instead. The
               emptiness is derived, not asserted: it is whatever the pinned changelog holds
               above its newest version heading. */
            releaseFacts.core.changelog.unreleased.sections.length === 0 ? (
              <p class="change-empty">
                The pinned changelog records nothing above
                <span translate="no"> v{releaseFacts.core.version}</span>, so this
                release is its own newest entry. Work landing after it appears here
                when the pin moves.
              </p>
            ) : (
              releaseFacts.core.changelog.unreleased.sections.map((section) => (
                <div class="change-group">
                  <h4>{section.title}</h4>
                  <ul>
                    {section.items.map((item) => <li>{item}</li>)}
                  </ul>
                </div>
              ))
            )
          }
        </article>

        <article id="baseline">
          <div class="entry-heading">
            <span>Package baseline</span>
            {/* The date sits beside the heading, not inside it, so the heading's name is the
                version alone (R4 in docs/site-audit.md). */}
            <h3>v{releaseFacts.core.changelog.currentVersion.heading}</h3>
            {releaseFacts.core.changelog.currentVersion.date && (
              <time class="entry-date" datetime={releaseFacts.core.changelog.currentVersion.date}>
                {releaseFacts.core.changelog.currentVersion.date}
              </time>
            )}
          </div>
          <p>{releaseFacts.core.changelog.currentVersion.summary}</p>
          <ul class="baseline-list">
            {baselineHighlights.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section provenance-method section-rule">
    <div class="shell">
      <div class="method-heading">
        <h2 class="section-title">A claim has to survive the build.</h2>
      </div>
      <ol class="method-steps">
        <li>
          <GitCommit size={24} aria-hidden="true" />
          <h3>Pin</h3>
          <p>Name every source by its full commit, and the publication channel.</p>
        </li>
        <li>
          <Code2 size={24} aria-hidden="true" />
          <h3>Parse</h3>
          <p>Read package metadata, changelog entries, and app manifests structurally.</p>
        </li>
        <li>
          <Clock3 size={24} aria-hidden="true" />
          <h3>Record</h3>
          <p>Publish source links, schema version, channel, and build time together.</p>
        </li>
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  /* Verify: the proof page's working part, kept plain. */
  .verify-steps {
    display: grid;
    margin: 0;
    padding: 0 0 0 1.4rem;
    gap: 2.25rem;
    max-width: 52rem;
  }

  .verify-steps li {
    padding-left: 0.4rem;
  }

  .verify-steps li::marker {
    color: var(--ink-muted);
    font-family: var(--font-mono);
  }

  .verify-steps h3 {
    margin: 0 0 0.5rem;
    font-size: var(--fs-title);
    font-weight: var(--fw-title);
    line-height: var(--lh-title);
  }

  .verify-steps p {
    margin: 0.75rem 0 0.5rem;
    color: var(--ink-soft);
  }

  /* A command here is read before it is run, so it wraps in its well instead of scrolling out of
     sight. The copy is still the one line. */
  .verify-steps :global(.command-line) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .digest {
    overflow-wrap: anywhere;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
  }

  .asset-table {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .asset-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-label);
  }

  .asset-caption {
    margin: 0;
    padding: 1rem 1.1rem;
    color: var(--ink-soft);
  }

  .asset-table th,
  .asset-table td {
    padding: 0.8rem 1.1rem;
    border-top: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .asset-table thead th {
    color: var(--ink-muted);
    font-weight: 650;
  }

  .asset-table tbody th,
  .asset-table tbody td {
    vertical-align: middle;
  }

  .asset-table tbody th {
    padding-block: 0.15rem;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 450;
    overflow-wrap: anywhere;
  }

  .asset-table td:nth-child(2) {
    white-space: nowrap;
  }

  .asset-table td:nth-child(3) {
    min-width: 18rem;
  }

  .asset-table a,
  .verify-steps p a,
  .verify-limits a {
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    color: var(--coral-bright);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .verify-limits {
    display: grid;
    margin: 1.75rem 0 0;
    padding-left: 1.2rem;
    gap: 0.5rem;
    max-width: 60rem;
    color: var(--ink-soft);
  }

  .manifest-source {
    margin-top: 2rem;
  }

  .manifest-source summary {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--coral-bright);
    cursor: pointer;
    font-weight: 650;
  }

  .manifest-source pre {
    max-height: 26rem;
    margin: 0.75rem 0 0;
    padding: 1rem 1.1rem;
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--well);
    color: var(--ink-soft);
    font-size: var(--fs-mono);
    line-height: var(--lh-mono);
  }

  /* The categories as a list, not number tiles (R2 in docs/site-audit.md). */
  .category-list {
    display: grid;
    margin: 0;
    padding: 0;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .category-list li {
    display: flex;
    min-height: 3rem;
    padding: 0.6rem 0;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    padding-inline-end: 1.5rem;
  }

  .category-apps {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
  }

  .release-hero {
    padding: clamp(3rem, 7vw, 6rem) 0 clamp(3rem, 6vw, 5rem);
    overflow: hidden;
  }

  .release-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(360px, 0.85fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
  }

  /* The text column sits at the top of the row, so the h1 lines up with the clip's top rather than
     sinking to the row's foot beside it; the clip keeps its own alignment. */
  .release-heading {
    align-self: start;
  }

  /* The heading scale /compare's h1 uses: this is a proof page, and its proof is below. */
  h1 {
    max-width: 18ch;
    margin-bottom: 1.6rem;
  }

  .release-lede {
    max-width: 43rem;
    color: var(--ink-soft);
    font-size: 1.12rem;
  }

  .source-status {
    display: inline-flex;
    min-height: 44px;
    margin-top: 1rem;
    gap: 0.65rem;
    align-items: center;
    color: var(--amber);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .source-status.is-release {
    color: var(--success);
  }

  /* The pinned source in one strip under the hero: channel, version, apps, schema, build. */
  .snapshot-summary {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    border-block: 1px solid var(--line-strong);
  }

  .snapshot-summary dl {
    display: grid;
    margin: 0;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .snapshot-summary dl div {
    display: grid;
    padding: 0.9rem 1.25rem 0.9rem 0;
    gap: 0.35rem;
    align-content: start;
  }

  .snapshot-summary dl div + div {
    padding-left: 1.25rem;
    border-left: 1px solid var(--line);
  }

  .snapshot-summary dt {
    color: var(--ink-muted);
    font-size: var(--fs-label);
  }

  /* Values, not commands, so the body face (DESIGN.md keeps mono for commands and paths). */
  .snapshot-summary dd {
    margin: 0;
    color: var(--ink);
    font-size: var(--fs-label);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }

  .text-link {
    display: inline-flex;
    min-height: 44px;
    gap: 0.45rem;
    align-items: center;
    color: var(--coral-bright);
    font-weight: 650;
  }

  .text-link:hover {
    color: var(--ink);
  }

  .source-section {
    background: var(--night-soft);
  }

  .source-ledger {
    border-top: 1px solid var(--line-strong);
  }

  .source-ledger article {
    display: grid;
    min-height: 180px;
    padding-block: 1.5rem;
    grid-template-columns: minmax(220px, 0.75fr) minmax(0, 1.25fr);
    gap: 2rem;
    align-items: center;
    border-bottom: 1px solid var(--line-strong);
  }

  /* Plain labels: coral marks action and focus, and mono is for commands (DESIGN.md). */
  .source-name > span,
  .entry-heading > span {
    color: var(--ink-muted);
    font-size: var(--fs-label);
  }

  .source-name h3 {
    margin: 0.45rem 0 0;
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    font-weight: 480;
    overflow-wrap: anywhere;
  }

  .source-ledger dl {
    display: grid;
    margin: 0;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line);
  }

  .source-ledger dl div {
    min-height: 94px;
    padding: 1rem;
    background: var(--surface);
  }

  .source-ledger dt {
    display: flex;
    margin-bottom: 0.75rem;
    gap: 0.45rem;
    align-items: center;
    color: var(--ink-muted);
    font-size: 0.78rem;
  }

  .source-ledger dd {
    margin: 0;
  }

  /* A tag as short as "v0.2.6" is under 44 px wide in some fonts; the box keeps the target. */
  .source-ledger dd a {
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    gap: 0.5rem;
    align-items: center;
    color: var(--ink);
  }

  .source-ledger dd a:hover {
    color: var(--coral-bright);
