---
import BaseLayout from "../layouts/BaseLayout.astro";
import { BoundaryViews } from "../components/BoundaryViews";
import { releaseFacts } from "../data/release";
import security from "../data/security.json";
import capabilities from "../data/capabilities.json";
import { ledgerRow } from "../data/capabilities.mjs";

/*
 * EVERY CLAIM ON THIS PAGE IS A ROW IN src/data/security.json, read against core at the pinned
 * release, and scripts/validate-security-render.mjs holds the page to it: each control links the
 * file that enforces it at the tag, the boundary table has one row per boundary in its five
 * columns, and the known limits come before the controls and name the release they were read at.
 *
 * THE CLAIMS THAT WERE NARROWED, and why, so they are not widened again:
 *
 *   - Guarded egress. It used to say network access passes through allow and deny host policy
 *     instead of ambient fetch, which overclaimed twice. The exclusive "only these hosts" stance
 *     is not the default: a run reaches only listed hosts when the governance ceiling sets its
 *     egress tier, and the default profile blocks address classes rather than listing
 *     destinations. And it is not the whole machine: an app backend is a separate process with
 *     its own network stack, and its traffic never passes the guard. The `egress_default_deny`,
 *     `single_chokepoint` and `egress_allowlist_exclusive` rows on /compare carry the findings.
 *   - The security log. It said "HMAC-linked security events make alteration visible". Each
 *     entry carries an HMAC over its own record, so an entry edited in place fails
 *     `verify_integrity` in `sel.py`; the same function tolerates breaks in the chain on purpose,
 *     since several processes append to one log, so a deleted entry goes unreported (S1 in
 *     docs/site-audit.md, the /compare `audit_log` row).
 *   - Optional sign-in. The threat model cites nothing for it, so its row cites the login door
 *     itself, `dashboard/handlers/auth.py`, which says it never becomes the only way in.
 *   - The dependency audit. It is no longer report-only, but nothing requires it to pass before a
 *     change reaches the default branch (the `dep_scan_gate` row).
 *
 * The arrow chain and the numbered 01 to 07 grid are gone (S3, S4): the boundary is drawn in two
 * views of zones and the boundaries between them, as live text, and the controls are rows, not a
 * sequence. Authority is a line, because it is one: a proposal is checked, then answered, then run,
 * then recorded. Network is a hub on the gateway and must stay one: drawn as a line, the egress
 * guard sat between an app and the internet, which says an app's backend traffic passes the guard,
 * and it never does (scripts/security-page.mjs refuses a network view drawn as a line). The threat model and the limitations page are linked in-site, since both are part of
 * the /docs corpus generated from the pin; SECURITY.md is not in that corpus, so it is pinned to
 * the release commit. scripts/validate-source-pins.mjs fails the build on a branch-pinned link.
 */

const securityPolicyUrl =
  `${releaseFacts.core.source.repositoryUrl}/blob/${releaseFacts.core.source.commit}/SECURITY.md`;

const statusLabels = Object.fromEntries(
  Object.entries(capabilities.verdicts).map(([id, verdict]) => [id, verdict.label])
);

const checkedOn = new Date(`${security.checked_on}T12:00:00Z`).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC"
});

// Each limit's link names where it goes, so no two links share a name and a destination differs.
// Each Compare row a limit names comes through the ledger, which refuses one not verified at the
// pin or not listing /security among its surfaces.
const limitSource = (limit: { compare?: string; href?: string; href_label?: string }) =>
  limit.compare
    ? {
        href: `/compare#${limit.compare}`,
        label: `On Compare, ${statusLabels[ledgerRow(limit.compare, "security").verdict].toLowerCase()}: “${ledgerRow(limit.compare, "security").claim.replace(/\.$/, "")}”`
      }
    : { href: limit.href ?? "/docs/security/limitations", label: limit.href_label ?? "The limitations page" };

// A citation is a file and, after a comma, the symbol in it. The symbol gets its own line, and the
// path breaks only after a slash, never inside a name. The comma stays in the text, so the link's
// name is the citation as the data states it.
const citation = (label: string) => {
  const [path, ...symbol] = label.split(", ");
  return { path: path.split(/(?<=\/)/), symbol: symbol.join(", ") };
};

// The verdicts the boundaries carry, defined where the map shows them.
const verdictMeanings: Record<string, string> = Object.fromEntries(
  Object.entries(capabilities.verdicts).map(([id, verdict]) => [id, verdict.meaning])
);
const usedVerdicts = Object.keys(verdictMeanings).filter((id) =>
  security.boundaries.some((boundary) => boundary.status === id)
);

const viewLabel = Object.fromEntries(security.views.map((view) => [view.id, view.label]));
---

<BaseLayout
  title="Security · PersonalClaw"
  description="Where PersonalClaw's boundary is, what it does not enforce, and the file that enforces each control at the pinned release."
>
  <section class="security-hero">
    <div class="shell hero-layout">
      <h1 class="display"><span>The model proposes.</span> <span>The host decides.</span></h1>
      <div class="hero-copy">
        <p data-support>
          Host code outside the model answers what an agent asks: an approval gate, not an
          operating-system jail.
        </p>
        <a class="button button-primary" href="#limits">Read what it does not enforce</a>
      </div>
    </div>
  </section>

  <section class="section boundary section-rule" id="boundary" aria-labelledby="boundary-title">
    <div class="shell">
      <div class="section-head">
        <h2 id="boundary-title">Where the boundary is</h2>
        <p>
          Two ways to read one boundary: who decides what runs, and where your data goes. Each
          label opens its row in the table under the map.
        </p>
      </div>

      <BoundaryViews
        client:load
        views={security.views}
        crossings={security.boundaries.map(({ id, view, crossing, status }) => ({ id, view, crossing, status }))}
        statusLabels={statusLabels}
      />

      <dl class="verdict-key">
        {usedVerdicts.map((id) => (
          <div>
            <dt>{statusLabels[id]}</dt>
            <dd>{verdictMeanings[id]}</dd>
          </div>
        ))}
      </dl>

      <div class="boundary-table" role="region" aria-labelledby="boundary-table-caption" tabindex="0">
        <table data-boundaries>
          <caption id="boundary-table-caption">Every boundary, with its evidence and its known limit</caption>
          <thead>
            <tr>
              <th scope="col">Boundary</th>
              <th scope="col">Responsibility</th>
              <th scope="col">Enforcement</th>
              <th scope="col">Evidence</th>
              <th scope="col">Known limit</th>
            </tr>
          </thead>
          <tbody>
            {security.boundaries.map((boundary) => {
              const cite = citation(boundary.evidence_label);
              return (
              <tr id={`boundary-${boundary.id}`} data-boundary={boundary.id} data-view={boundary.view}>
                <th scope="row">
                  {boundary.name}
                  <span class="boundary-view">{viewLabel[boundary.view]}</span>
                </th>
                <td data-label="Responsibility">{boundary.responsibility}</td>
                <td data-label="Enforcement">{statusLabels[boundary.status] ?? boundary.status}</td>
                <td data-label="Evidence">
                  <a href={boundary.evidence_url}>
                    <code><span class="cite-path">{cite.path.map((part) => <Fragment>{part}<wbr /></Fragment>)}{cite.symbol && ","}</span>{cite.symbol && <span class="cite-symbol"> {cite.symbol}</span>}</code>
                  </a>
                </td>
                <td data-label="Known limit"><a href={boundary.limit_href}>{boundary.limit}</a></td>
              </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section limits" id="limits" aria-labelledby="limits-title">
    <div class="shell limits-layout">
      <div class="limits-intro">
        <h2 id="limits-title" class="section-title">What it does not enforce</h2>
        <p>
          Read against {security.release}, the last release we verified, on {checkedOn}. Each
          one links where it is stated in full.
        </p>
        <a class="button button-secondary" href="/docs/security/limitations">Read every limitation</a>
      </div>
      <ul class="limit-list" role="list">
        {security.limits.map((limit) => {
          const source = limitSource(limit);
          return (
            <li data-limit={limit.id}>
              <p>{limit.statement}</p>
              <a href={source.href}>{source.label}</a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="section controls section-rule" id="controls" aria-labelledby="controls-title">
    <div class="shell">
      <div class="section-head">
        <h2 id="controls-title">The controls, and the code that enforces each</h2>
        <p>
          Each links the file that enforces it at {security.release}. A control is listed only
          if that code has a live caller at the tag; a setting nothing reads is not a control.
        </p>
      </div>
      <ul class="control-rows" role="list">
        {security.controls.map((control) => {
          const cite = citation(control.source_label);
          return (
          <li data-control={control.id}>
            <h3>{control.name}</h3>
            <div>
              <p>{control.statement}</p>
              <a href={control.source_url}>
                <code><span class="cite-path">{cite.path.map((part) => <Fragment>{part}<wbr /></Fragment>)}{cite.symbol && ","}</span>{cite.symbol && <span class="cite-symbol"> {cite.symbol}</span>}</code>
              </a>
            </div>
          </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="section supply section-rule" aria-labelledby="supply-title">
    <div class="shell supply-layout">
      <div class="supply-intro">
        <h2 id="supply-title" class="section-title">An app is code, not a collectible.</h2>
        <p>
          Installing one is a staged trust decision. The package stays apart until it is
          scanned and you have consented to what it declares.
        </p>
        <a href={security.supply_chain_source.url}><code>{security.supply_chain_source.label}</code></a>
      </div>
      <ol class="supply-steps" role="list">
        {security.supply_chain.map((step) => (
          <li>
            <strong>{step.name}</strong>
            <span>{step.statement}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section report section-rule" aria-labelledby="report-title">
    <div class="narrow">
      <h2 id="report-title" class="section-title">Report a vulnerability</h2>
      <p>
        Core's security policy says how to report one privately and what to expect back. The
        threat model behind this page names each trust boundary and maps the OWASP agentic risks
        to the code that answers them.
      </p>
      <div class="report-links">
        <a class="button button-primary" href={securityPolicyUrl} target="_blank" rel="noreferrer">
          Read the security policy
        </a>
        <a class="button button-secondary" href="/docs/security/threat-model">Read the threat model</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* The hero is short on purpose: the boundary itself is the first thing to read, so the map's
     views start inside the first viewport at 1440 by 900. */
  .security-hero {
    padding: clamp(3rem, 5vw, 4.5rem) 0 clamp(1.5rem, 3vw, 2.5rem);
  }

  .hero-layout {
    display: grid;
    gap: 1.5rem;
  }

  h1 {
    margin: 0;
  }

  /* Each sentence on its own line, so the break never falls inside one. */
  h1 span {
    display: block;
  }

  .hero-copy {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: center;
  }

  .hero-copy > p {
    max-width: 46ch;
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--fs-body);
  }

  .boundary {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .boundary .section-head {
    margin-bottom: 2rem;
  }

  /* The map's key, under it: what each verdict on a label (and in the Enforcement column) means. */
  .verdict-key {
    display: grid;
    max-width: 68ch;
    margin: 1.5rem 0 0;
    gap: 0.35rem;
    color: var(--ink-soft);
    font-size: var(--fs-label);
  }

  .verdict-key dt {
    display: inline;
    color: var(--ink);
    font-weight: 600;
  }

  .verdict-key dt::after {
    content: ": ";
  }

  .verdict-key dd {
    display: inline;
    margin: 0;
  }

  /* A section's heading sits over its sentence, not beside it: the sentence reads as the
     heading's lead, and the table and map under it get the full width to start from. */
  .section-head {
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .section-head h2 {
    max-width: 22ch;
  }

  /* The two views. The tabs are the System Window's: a pill strip, the selected one coral. */
  /* A label never breaks: at 200% text on a phone the strip scrolls instead, as the System
     Window's does. */
  :global(.boundary-tabs) {
    display: inline-flex;
    max-width: 100%;
    overflow-x: auto;
    padding: 3px;
    gap: 2px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--night);
  }

  :global(.boundary-tabs button) {
    flex: none;
    min-width: 96px;
    min-height: 44px;
    padding: 0.35rem 1rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-muted);
    cursor: pointer;
    font-size: var(--fs-label);
    font-weight: 650;
    white-space: nowrap;
  }

  :global(.boundary-tabs button[aria-selected="true"]) {
    background: var(--coral);
    color: var(--night);
  }

  @media (forced-colors: active) {
    :global(.boundary-tabs button[aria-selected="true"]) {
      outline: 2px solid Highlight;
      outline-offset: -2px;
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 0.25em;
    }
  }

  :global(.boundary-summary) {
    max-width: 68ch;
    margin: 1rem 0 1.5rem;
    color: var(--ink-soft);
  }

  /* The map: zones in a row, and between two zones the boundary itself, a line with its label.
     No arrows: the line is where one side's trust ends, not a step in a flow. */
  :global(.boundary-map) {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(.boundary-zone) {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.25rem 1rem;
    border-top: 1px solid var(--line-strong);
  }

  /* A zone's name never breaks inside a word: at the narrowest column it wraps between words. */
  :global(.boundary-zone strong) {
    font-size: clamp(1.1rem, 1.6vw, 1.4rem);
    font-weight: var(--fw-title);
    line-height: var(--lh-title);
    overflow-wrap: normal;
    word-break: normal;
  }

  :global(.boundary-zone span) {
    color: var(--ink-soft);
    font-size: var(--fs-label);
  }

  :global(.boundary-crossing) {
    position: relative;
    display: grid;
    width: 8.5rem;
    justify-items: center;
  }

  :global(.boundary-line) {
    position: absolute;
    inset: 0 auto 0 50%;
    border-left: 2px dashed var(--line-strong);
  }

  /* A label is the link to its boundary's row in the table: ink, not coral, until it is the
     thing being pointed at. */
  :global(.boundary-label) {
    position: relative;
    display: grid;
    align-self: start;
    margin-top: 1.25rem;
    padding: 0.5rem 0.65rem;
    gap: 0.15rem;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--night);
    color: var(--ink);
    text-align: center;
    text-decoration: none;
  }

  :global(.boundary-label:hover) {
    border-color: var(--coral-bright);
  }

  :global(.boundary-label strong) {
    font-size: var(--fs-label);
    font-weight: 600;
    line-height: var(--lh-label);
  }

  :global(.boundary-label span) {
    color: var(--ink-muted);
    font-size: var(--fs-mono);
  }

  :global(.boundary-crossing[data-status="yes"] .boundary-label span) {
    color: var(--success);
  }

  /* The Network view: the gateway's zone, and a spoke for each boundary between it and one thing
     outside it, its line running from the gateway's edge to that zone. */
  :global(.boundary-hub) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.6fr);
  }

  :global(.boundary-hub .boundary-hub-zone) {
    padding: 1.25rem 1.25rem;
    border-right: 1px solid var(--line-strong);
    border-radius: 8px 0 0 8px;
    background: var(--night-soft);
  }

  :global(.boundary-spokes) {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(.boundary-spoke) {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    border-top: 1px solid var(--line-strong);
  }

  :global(.boundary-spoke .boundary-zone) {
    padding: 1rem;
    border-top: 0;
  }

  :global(.boundary-spoke .boundary-crossing) {
    width: auto;
    align-items: center;
  }

  :global(.boundary-spoke .boundary-line) {
    inset: 50% 0 auto 0;
    border-top: 2px dashed var(--line-strong);
    border-left: 0;
  }

  /* Every spoke's label one width, so the four read as one column of boundaries. */
  :global(.boundary-spoke .boundary-label) {
    width: 8.5rem;
    margin: 0;
    align-self: center;
  }

  .boundary-table {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  table {
    width: 100%;
    min-width: 64rem;
    border-collapse: collapse;
    font-size: var(--fs-label);
  }

  caption {
    padding: 1rem 1.25rem;
    color: var(--ink-soft);
    font-weight: 600;
    text-align: left;
  }

  th,
  td {
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--line);
    overflow-wrap: normal;
    word-break: normal;
    text-align: left;
    vertical-align: top;
  }

  thead th {
    color: var(--ink-muted);
    font-size: var(--fs-label);
    font-weight: 600;
  }

  tbody th {
    width: 16%;
    font-weight: 600;
  }

  /* Wide enough for the longest cited name on one line, so a path breaks only at its slashes. */
  thead th:nth-child(4) {
    width: 12rem;
  }

  .boundary-view {
    display: block;
    margin-top: 0.25rem;
    color: var(--ink-muted);
    font-size: var(--fs-mono);
    font-weight: 500;
  }

  /* A cited path breaks after a slash (the page puts a break opportunity there) and its symbol
     takes the next line; one longer than its line, at 200% text on a phone, breaks where it must
     rather than overflow. */
  td code,
  .control-rows code,
  .supply-intro code {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    overflow-wrap: anywhere;
  }

  /* In the table's own column a name never breaks inside itself: the anywhere rule would let the
     column shrink to a few characters. Stacked on a phone, the cell is the full width again. */
  td code {
    overflow-wrap: normal;
  }

  .cite-path,
  .cite-symbol {
    display: block;
  }

  /* Each of these links stands on its own line, so each is a 44 px target. */
  td a,
  .limit-list a,
  .control-rows a,
  .supply-intro a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--coral-bright);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .limits {
    background: var(--night-soft);
  }

  .limits-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  /* The intro stays in sight beside the list it introduces, so the release it was read at does. */
  .limits-intro {
    position: sticky;
    top: 6rem;
  }

  .limits-intro p {
    max-width: 38ch;
    color: var(--ink-soft);
  }

  .limit-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .limit-list li {
    display: grid;
    gap: 0.4rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--line);
  }

  .limit-list p {
    max-width: 68ch;
    margin: 0;
  }

  .limit-list a {
    width: fit-content;
    font-size: var(--fs-label);
  }

  .control-rows {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .control-rows li {
    display: grid;
    grid-template-columns: minmax(0, 0.35fr) minmax(0, 1fr);
    gap: 2rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
  }

  .control-rows h3 {
    margin: 0;
    font-size: var(--fs-title);
    font-weight: var(--fw-title);
    line-height: var(--lh-title);
  }

  .control-rows p {
    max-width: 68ch;
    margin: 0 0 0.5rem;
    color: var(--ink-soft);
  }

  .supply-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .supply-intro p {
    max-width: 40ch;
    color: var(--ink-soft);
  }

  .supply-steps {
    display: grid;
    margin: 0;
    padding: 0;
    counter-reset: step;
    list-style: none;
  }

  .supply-steps li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    column-gap: 1rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--line);
    counter-increment: step;
  }

  .supply-steps li::before {
    grid-row: span 2;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    content: counter(step);
  }

  .supply-steps strong {
    font-weight: 600;
  }

  .supply-steps span {
    color: var(--ink-soft);
  }

  .report p {
    color: var(--ink-soft);
  }

  .report-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 1100px) {
    :global(.boundary-map) {
      grid-auto-flow: row;
      grid-auto-columns: auto;
    }

    :global(.boundary-zone) {
      padding-inline: 0;
    }

    :global(.boundary-crossing) {
      width: auto;
      min-height: 4.5rem;
      justify-items: start;
      align-items: center;
    }

    :global(.boundary-line) {
      inset: 50% 0 auto 0;
      border-top: 2px dashed var(--line-strong);
      border-left: 0;
    }

    :global(.boundary-label) {
      margin: 0;
      text-align: left;
    }
  }

  /* On a phone the table keeps its semantics and reads row by row: each cell under its column's
     name, so nothing scrolls sideways. */
  @media (max-width: 760px) {
    table {
      min-width: 0;
    }

    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    tbody tr {
      display: grid;
      padding: 1rem 1.25rem;
      gap: 0.75rem;
      border-top: 1px solid var(--line);
    }

    tbody th,
    tbody td {
      display: grid;
      width: auto;
      padding: 0;
