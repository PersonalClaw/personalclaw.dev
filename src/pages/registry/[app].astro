---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SheetEvidence } from "../../components/SheetEvidence";
import FieldRow from "../../components/SheetFieldRow.astro";
import capabilities from "../../data/capabilities.json";
import {
  EVIDENCE_PANELS,
  FIRST_PARTY_SCAN,
  INSTALL_GATE_SENTENCE,
  SHEET_CLAIMS,
  STORE_CONSENT,
  appSheets
} from "../../data/registry.mjs";

/*
 * THE INSTALL-SAFETY SHEET (#112): everything an owner reads before installing an app or
 * switching it on, for a first-party app of the pinned release and for a community listing alike.
 * Every fact is its source's own (src/data/registry.mjs: appSheets), and a fact with no source
 * says so in a fixed line; scripts/validate-registry-render.mjs holds each one to its raw source.
 *
 * The order is the decision's: the decision itself first (and, for a community listing, the
 * Store's three consent jobs in the Store's order: not endorsed, the attributed verdict, the
 * install-time rescan), with whether it works with this release; then what it gets, the programs
 * it starts, what it reaches, the secrets you would enter, what installing it runs, where it comes
 * from, the sequence from review to enable, and the evidence, which holds the scan record. Each
 * field shows once. The enable steps are the sheet's one action, and an unsafe or incompatible
 * sheet has none: it says why instead.
 */

// One page per sheet. scripts/validate-build.mjs and tests/support/site-contract.mjs derive the
// contracted route set from the same function, so the pages and the contract cannot disagree.
export function getStaticPaths() {
  return appSheets().sheets.map((sheet) => ({ params: { app: sheet.name }, props: { sheet } }));
}

type Field = { id: string; label: string; value: string | string[] | null; missing: string };
type Sheet = {
  kind: "first-party" | "community";
  name: string;
  path: string;
  subtitle: string;
  description: string;
  verdict: { key: string; label: string; tone: string; detail: string };
  state: "unsafe" | "incompatible" | "available";
  blockedBecause: string | null;
  facts: Field[];
  declarations: Field[];
  missingFields?: string[];
  reach: { by: string; why: string; hosts: string[] }[] | null;
  launches: { program: string; why: string; npmPackage: string; hosts: string[]; runsWith: string }[] | null;
  secrets: { key: string; label: string }[] | null;
  manifest: { text: string; blob: string; path: string; url: string } | null;
  sourceUrl: string;
  provenance: string;
};

const { sheet } = Astro.props as { sheet: Sheet };
const { release } = appSheets();
const firstParty = sheet.kind === "first-party";
const blocked = sheet.state !== "available";

// The sequence's claims are verification-ledger rows; a claim without a current row is not shown.
const claims = SHEET_CLAIMS.map((id: string) => capabilities.rows.find((row) => row.id === id)).filter(
  (row): row is (typeof capabilities.rows)[number] => row !== undefined
);
const claim = Object.fromEntries(claims.map((row) => [row.id, row]));
const secretsClaim = claim.secrets_in_credential_store;

const stateWords: Record<Sheet["state"], string> = {
  unsafe: "Unsafe: do not install",
  incompatible: `Will not install on PersonalClaw ${release.tag}`,
  available: firstParty ? `A first-party app of PersonalClaw ${release.tag}` : STORE_CONSENT.notEndorsed
};
// A community listing's repository is a third party's URL, not one this site vouches for.
const COMMUNITY_REL = "nofollow ugc";
const declared = sheet.declarations.filter((entry) => entry.value !== null);
const undeclared = sheet.declarations.filter((entry) => entry.value === null);

// Every field once, where the decision reads it: whether it works with this release in the
// decision itself, then what it gets, what it reaches, the secrets, where it comes from, and the
// scan record in its evidence panel (the verdict leads the decision already).
const byId = Object.fromEntries(sheet.facts.map((entry) => [entry.id, entry]));
const fields = (ids: string[]) => ids.map((id) => byId[id]).filter((entry): entry is Field => entry !== undefined);
const glance = fields(["compatibility"]);
const gets = fields(["permissions", "network"]);
const origin = fields(["source", "publisher", "license", "commit", "signer"]);
const scan = fields(["scanVerdict", "scanTime", "findings", "scanner"]);
---

<BaseLayout
  title={`${sheet.name} · Install-safety sheet · PersonalClaw`}
  description={`What ${sheet.name} gets, reaches and runs before you install it or switch it on, read from the pinned release and registry sources.`}
>
  <article class="sheet" data-sheet={sheet.name} data-kind={sheet.kind} data-state={sheet.state}>
    <div class="shell">
      <a class="text-link back-link" href={firstParty ? "/apps" : "/registry"}>
        {firstParty ? "All apps" : "The community registry"}
      </a>

      <p class="sheet-kind">
        {firstParty ? "First-party app" : "Community listing"}
        {sheet.subtitle && <span translate="no"> · {sheet.subtitle}</span>}
      </p>
      <h1 class="section-title" translate="no">{sheet.name}</h1>
      {sheet.description && <p class="sheet-description">{sheet.description}</p>}

      {/* The decision, first. For a community listing this is the Store's consent contract in the
          Store's order (src/data/registry.mjs: STORE_CONSENT), and the render check holds the
          order. A screen reader meets this region before anything else on the sheet. */}
      <section class="decision" aria-labelledby="decision-title" data-decision>
        <h2 id="decision-title" class="sr-only">Before you install</h2>
        {!firstParty && <p class="registry-not-endorsed">{STORE_CONSENT.notEndorsed}</p>}
        {(firstParty || blocked) && (
          <p class:list={["decision-state", `state-${sheet.state}`]} data-state-label>{stateWords[sheet.state]}</p>
        )}
        <p class:list={["registry-verdict", `verdict-${sheet.verdict.tone}`]} data-verdict={sheet.verdict.key}>
          <span>{sheet.verdict.label}</span>
        </p>
        <p class="verdict-detail">{sheet.verdict.detail}</p>
        <p class="install-gate">{INSTALL_GATE_SENTENCE}</p>
        {blocked && <p class="blocked-because" data-blocked-because>{sheet.blockedBecause}</p>}
        <dl class="sheet-facts glance">
          {glance.map((entry) => <FieldRow entry={entry} />)}
        </dl>
      </section>

      <section class="block" aria-labelledby="facts-title">
        <h2 id="facts-title">What it gets</h2>
        <dl class="sheet-facts">
          {gets.map((entry) => <FieldRow entry={entry} />)}
        </dl>
      </section>

      {sheet.launches && sheet.launches.length > 0 && (
        <section class="block" aria-labelledby="starts-title">
          <h2 id="starts-title">What it starts</h2>
          <p class="lede">The programs on this machine it starts, as install consent names them.</p>
          <ul class="launch-list" data-launches>
            {sheet.launches.map((launch) => (
              <li data-launch={launch.program}>
                <p>
                  <strong>{launch.program === "*" ? "The programs you name for it" : <code translate="no">{launch.program}</code>}</strong>
                  {launch.why ? `: ${launch.why}` : ""}
                </p>
                {launch.npmPackage && (
                  <p>It fetches and runs the npm package <code translate="no">{launch.npmPackage}</code>.</p>
                )}
                {launch.runsWith && <p>{launch.runsWith}</p>}
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="block" aria-labelledby="reach-title" data-reach>
        <h2 id="reach-title">What it reaches</h2>
        <dl class="sheet-facts">
          {fields(["hosts"]).map((entry) => <FieldRow entry={entry} />)}
        </dl>
        <p class="reach-note" data-reach-note>
          Its own code has no host list at this release: the hosts above are the ones it names for
          the programs, servers and sources it starts or fetches, not everything it can reach.
          Its own network permission is a declaration, not a fence.
        </p>
      </section>

      <section class="block" aria-labelledby="secrets-title">
        <h2 id="secrets-title">Secrets you would enter</h2>
        <dl class="sheet-facts">
          {fields(["secrets"]).map((entry) => <FieldRow entry={entry} />)}
        </dl>
        {sheet.secrets && sheet.secrets.length > 0 && (
          <>
            {secretsClaim && <p class="lede after-facts">{secretsClaim.statement}</p>}
            <p class="lede">Its own code calls PersonalClaw's gateway with a token scoped to the app, not with your owner token.</p>
          </>
        )}
      </section>

      <section class="block" aria-labelledby="runs-title">
        <h2 id="runs-title">What installing it gives and runs</h2>
        <p class="lede">
          {firstParty
            ? "The manifest's own declarations, under the names install consent shows them by and in its order. The Store adds, at install, which of them run as you."
            : "A community listing records its permissions only. The rest is in the app's own manifest, which the Store reads at install."}
        </p>
        {declared.length > 0 && (
          <dl class="declarations">
            {declared.map((entry) => (
              <div data-declaration={entry.id}>
                <dt>{entry.label} <code translate="no" aria-hidden="true">{entry.id}</code></dt>
                <dd><pre tabindex="0" role="region" aria-label={`${entry.label}, as declared`} translate="no">{entry.value}</pre></dd>
              </div>
            ))}
          </dl>
        )}
        {/* What it does not declare is listed, never dropped: each by its name in consent. */}
        {undeclared.length > 0 && (
          <div class="undeclared">
            <p class="missing">{undeclared[0].missing}:</p>
            <ul>
              {undeclared.map((entry) => (
                <li data-declaration={entry.id}>{entry.label} <code translate="no" aria-hidden="true">{entry.id}</code></li>
              ))}
            </ul>
          </div>
        )}
      </section>

      <section class="block" aria-labelledby="origin-title">
        <h2 id="origin-title">Where it comes from</h2>
        <dl class="sheet-facts">
          {origin.map((entry) => <FieldRow entry={entry} sourceRel={firstParty ? undefined : COMMUNITY_REL} />)}
        </dl>
        {!firstParty && (sheet.missingFields ?? []).length > 0 && (
          <p class="gaps" data-missing-fields>
            This listing does not record: {(sheet.missingFields ?? []).join(", ")}.
          </p>
        )}
      </section>

      <section class="block" aria-labelledby="sequence-title">
        <h2 id="sequence-title">From review to enable</h2>
        <ol class="sequence" role="list">
          {claim.install_rescan && (
            <li data-claim="install_rescan">
              <strong>Held and scanned.</strong> {claim.install_rescan.statement}
              <a class="inline-link" href="/compare#install_rescan">Its row on Compare<span class="sr-only">: install rescan</span></a>
            </li>
          )}
          {claim.dangerous_refused && (
            <li data-claim="dangerous_refused">
              <strong>A dangerous verdict ends it.</strong> {claim.dangerous_refused.statement}
              <a class="inline-link" href="/compare#dangerous_refused">Its row on Compare<span class="sr-only">: dangerous verdict</span></a>
            </li>
          )}
          {claim.consent_bound_to_review && (
            <li data-claim="consent_bound_to_review">
              <strong>You review and consent.</strong> {claim.consent_bound_to_review.statement}
              <a class="inline-link" href="/compare#consent_bound_to_review">Its row on Compare<span class="sr-only">: consent</span></a>
            </li>
          )}
          <li>
            <strong>Its setup runs, then you switch it on.</strong> Nothing it declares runs before
            your consent; an app already installed is offered as an update instead.
          </li>
        </ol>

        {blocked ? (
          <p class="no-enable" data-no-enable>{sheet.blockedBecause}</p>
        ) : (
          <div class="enable" data-enable-steps>
            <h3>To install it and switch it on</h3>
            <ol>
              <li>In PersonalClaw, open the Store.</li>
              <li>Find <span translate="no">{sheet.name}</span>.</li>
              <li>Review what it gets and runs, and consent.</li>
              <li>Install it, then switch it on.</li>
            </ol>
          </div>
        )}
      </section>

      <section class="block" aria-labelledby="evidence-title">
        <h2 id="evidence-title">Evidence</h2>
        <SheetEvidence client:load panels={EVIDENCE_PANELS}>
          <div slot="manifest">
            {sheet.manifest ? (
              <>
                <p class="lede">
                  <code translate="no">{sheet.manifest.path}</code> at the pinned commit, as written,
                  with the blob hash git lists for it: <code translate="no" data-manifest-blob>{sheet.manifest.blob}</code>
                </p>
                <p class="lede"><a class="inline-link" href={sheet.manifest.url}>Open it at the commit</a></p>
                <pre class="manifest" tabindex="0" role="region" aria-label={`${sheet.manifest.path}, as written`} translate="no" data-manifest>{sheet.manifest.text}</pre>
              </>
            ) : (
              <p class="missing" data-manifest>
                Not recorded for this listing. The listing names its repository, not a revision, so
                there is no manifest at a pin to show.
                <a class="inline-link" href={sheet.sourceUrl} rel={COMMUNITY_REL}>Open the repository</a>
              </p>
            )}
          </div>
          <div slot="scan">
            <dl class="sheet-facts">
              {scan.map((entry) => <FieldRow entry={entry} />)}
            </dl>
            <p class="lede">
              {firstParty
                ? FIRST_PARTY_SCAN.detail
                : "The registry keeps a validation's findings in a workflow artifact and a pull-request comment, not in its index, so they are not on this sheet."}
            </p>
          </div>
          <div slot="claims">
            <ul class="claims" role="list">
              {claims.map((row) => (
                <li data-claim-row={row.id}>
                  <p><strong>{row.claim}</strong></p>
                  <p>{row.statement}</p>
                  <a class="inline-link" href={row.source_url} translate="no">{row.source_label} at {release.tag}</a>
                </li>
              ))}
            </ul>
          </div>
        </SheetEvidence>
      </section>

      <p class="provenance" translate="no">{sheet.provenance}</p>
    </div>
  </article>
</BaseLayout>

<style>
  .sheet {
    padding: clamp(3rem, 6vw, 5rem) 0 clamp(5rem, 9vw, 8rem);
  }

  .text-link {
    display: inline-flex;
    min-height: 44px;
    gap: 0.45rem;
    align-items: center;
    color: var(--coral-bright);
    font-weight: 650;
  }

  .back-link {
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .sheet-kind {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--fs-label);
  }

  h1 {
    max-width: 22ch;
    margin: 0.4rem 0 1rem;
    overflow-wrap: anywhere;
  }

  .sheet-description {
    max-width: 68ch;
    margin: 0 0 1.5rem;
    color: var(--ink-soft);
  }

  .decision {
    display: grid;
    max-width: 68ch;
    gap: 0.6rem;
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
  }

  .decision[data-decision] p {
    margin: 0;
  }

  .decision-state {
    font-weight: 650;
  }

  .glance {
    margin-top: 0.4rem;
  }

  .state-unsafe,
  .state-incompatible {
    color: var(--ink);
  }

  .decision:has(.state-unsafe),
  .decision:has(.state-incompatible) {
    border-color: var(--ember);
    border-width: 2px;
  }

  .registry-not-endorsed {
    color: var(--ink);
    font-size: var(--fs-label);
    font-weight: 650;
  }

  /* Same four treatments as /registry: an absent verdict must not be able to read as a pass. */
  .registry-verdict {
    display: inline-flex;
    width: fit-content;
    padding: 0.28rem 0.62rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: var(--fs-label);
    font-weight: 650;
  }

  .verdict-pass {
    border-color: var(--success);
    color: var(--success);
  }

  .verdict-caution {
    background: var(--theater-high);
    color: var(--ink);
  }

  .verdict-blocked {
    border-color: var(--ember);
    border-width: 2px;
    background: var(--theater-high);
    color: var(--ink);
  }

  .verdict-unscanned {
    border-style: dashed;
  }

  .verdict-detail,
  .install-gate,
  .blocked-because {
    color: var(--ink-soft);
  }

  .blocked-because {
    color: var(--ink);
  }

  .block {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
    border-top: 1px solid var(--line);
  }

  h2 {
    margin: 0 0 1rem;
    font-size: var(--fs-title);
    font-weight: var(--fw-title);
    line-height: var(--lh-title);
  }

  h3 {
    margin: 1.5rem 0 0.75rem;
    font-size: var(--fs-body);
    font-weight: 650;
  }

  .lede {
    max-width: 68ch;
    margin: 0 0 1rem;
    color: var(--ink-soft);
  }

  .sheet-facts,
  .declarations {
    display: grid;
    max-width: 60rem;
    margin: 0;
  }

  .declarations div {
    display: grid;
    grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
    gap: 0.4rem 1.5rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--line);
  }

  dt {
    color: var(--ink-muted);
    font-size: var(--fs-label);
  }

  dd {
    min-width: 0;
    margin: 0;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .missing {
    color: var(--ink-soft);
  }

  .undeclared {
    margin-top: 1.25rem;
  }

  .undeclared p {
    margin: 0 0 0.5rem;
  }

  .undeclared ul {
    display: grid;
    max-width: 60rem;
    margin: 0;
    padding: 0;
    gap: 0.6rem 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
    list-style: none;
    color: var(--ink-soft);
    font-size: var(--fs-label);
  }

  .undeclared li code {
    display: block;
    color: var(--ink-muted);
  }

  .gaps,
  .reach-note {
    max-width: 68ch;
    margin: 1rem 0 0;
    color: var(--ink-soft);
  }

  .launch-list {
    display: grid;
    max-width: 68ch;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .launch-list li {
    padding: 0.85rem 0;
    border-top: 1px solid var(--line);
  }

  .launch-list p {
    margin: 0 0 0.35rem;
    color: var(--ink-soft);
  }

  .launch-list strong {
    color: var(--ink);
  }

  .after-facts {
    margin-top: 1rem;
  }

  pre {
    max-height: 22rem;
    margin: 0;
    padding: 0.85rem 1rem;
    overflow: auto;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--well);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .manifest {
    max-height: 34rem;
  }

  code {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    overflow-wrap: anywhere;
  }

  .sequence {
    display: grid;
    max-width: 72ch;
    margin: 0;
    padding: 0;
    counter-reset: step;
    list-style: none;
  }

  .sequence li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    column-gap: 1rem;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    counter-increment: step;
  }

  .sequence li > :not(:first-child) {
    grid-column: 2;
  }

  .sequence li::before {
    grid-row: span 3;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    content: counter(step);
  }

  .sequence strong {
    color: var(--ink);
  }

  .inline-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--coral-bright);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  .enable {
    max-width: 68ch;
    margin-top: 1.75rem;
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--night-soft);
  }

  .enable h3 {
    margin-top: 0;
  }

  .enable ol {
    margin: 0;
    padding-left: 1.3rem;
  }

  .no-enable {
    max-width: 68ch;
    margin: 1.5rem 0 0;
    padding: 1rem 1.2rem;
    border: 2px solid var(--ember);
    border-radius: 8px;
    color: var(--ink);
  }

  .claims {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .claims li {
    padding: 0.9rem 0;
    border-top: 1px solid var(--line);
  }

  .claims p {
    max-width: 68ch;
    margin: 0 0 0.35rem;
    color: var(--ink-soft);
  }

  .claims strong {
    color: var(--ink);
  }

  /* The tabs wrap at a narrow width rather than clipping a label with no sign it scrolls. */
  :global(.evidence-tabs) {
    display: inline-flex;
    max-width: 100%;
    margin-bottom: 1.25rem;
    padding: 3px;
    flex-wrap: wrap;
    gap: 2px;
    border: 1px solid var(--line);
    border-radius: 25px;
    background: var(--night);
  }

  /* A label may wrap inside its tab, so no tab is wider than a 320 px screen at 200% text. */
  :global(.evidence-tabs button) {
    flex: 0 1 auto;
    min-height: 44px;
    padding: 0.35rem 1rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-muted);
    cursor: pointer;
    font-size: var(--fs-label);
    font-weight: 650;
  }

  :global(.evidence-tabs button[aria-selected="true"]) {
    background: var(--coral);
    color: var(--night);
  }

  @media (forced-colors: active) {
    :global(.evidence-tabs button[aria-selected="true"]) {
      outline: 2px solid Highlight;
      outline-offset: -2px;
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 0.25em;
    }
  }

  :global(.evidence-panel + .evidence-panel:not([hidden])) {
    margin-top: 1.5rem;
  }

  .provenance {
    margin: clamp(3rem, 7vw, 5rem) 0 0;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    overflow-wrap: anywhere;
  }

  @media (max-width: 760px) {
    .declarations div {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
