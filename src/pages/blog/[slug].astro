---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { capabilityMatrix, verdictPresentation } from "../../data/capabilities.mjs";
import { GITHUB_URL } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const readableDate = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC"
}).format(post.data.publishDate);

// The claims a post names, as the verification ledger holds them now. A row the ledger has not
// verified at the pinned release shows as a known limit: the claim and when it was last checked,
// never a verdict a reader could take as current.
const matrix = capabilityMatrix();
const pinned = matrix.pin.tag;
const claims = post.data.claims.map((id) => {
  const row = matrix.rows.find((candidate) => candidate.id === id);
  if (!row) throw new Error(`${post.id}: names the claim "${id}", which the ledger does not hold`);
  if (!row.surfaces.includes("blog")) {
    throw new Error(`${post.id}: the ledger row "${id}" does not list blog among its surfaces`);
  }
  return row;
});
const behind = post.data.verifiedAgainst !== pinned;
---

<BaseLayout
  title={`${post.data.title} · PersonalClaw`}
  description={post.data.description}
  article={{
    title: post.data.title,
    description: post.data.description,
    publishDate: post.data.publishDate
  }}
>
  <article class="post" data-verified-against={post.data.verifiedAgainst}>
    <div class="narrow">
      <a class="text-link back-link" href="/blog">All posts</a>

      <h1 class="section-title">{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={post.data.publishDate.toISOString().slice(0, 10)}>{readableDate}</time>{" "}
        <a class="verified" href="/release" data-blog-verified>
          Verified against <span translate="no">{post.data.verifiedAgainst}</span>
        </a>
      </p>

      <aside class="callout" aria-labelledby="checked-title" data-blog-callout>
        <h2 id="checked-title">How this post was checked</h2>
        <p>
          Every claim in it names the file that proves it in{" "}
          <span translate="no">{post.data.verifiedAgainst}</span>, the release it was checked
          against.
          {behind && (
            <>
              {" "}This site now publishes <span translate="no">{pinned}</span>, and the post
              has not been checked again against it.
            </>
          )}
        </p>
        {claims.length > 0 && (
          <>
            <p>What its claims are at <span translate="no">{pinned}</span>, from /compare:</p>
            <ul class="claims">
              {claims.map((row) =>
                row.current ? (
                  <li data-blog-claim={row.id}>
                    <a href={`/compare#${row.id}`}>{row.claim}</a>{" "}
                    <span class="claim-verdict">{verdictPresentation(row.verdict).label}</span>
                  </li>
                ) : (
                  <li data-blog-claim-limit={row.id}>
                    <a href={`/compare#${row.id}`}>{row.claim}</a>{" "}
                    <span class="claim-verdict">
                      last checked at <span translate="no">{row.verifiedRelease}</span>
                    </span>
                  </li>
                )
              )}
            </ul>
          </>
        )}
        <p>
          A claim here that is wrong, or that no longer holds, is a defect.{" "}
          <a href={`${GITHUB_URL}/issues`} target="_blank" rel="noreferrer">Report it</a>
        </p>
      </aside>

      <div class="post-body">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding: clamp(3rem, 6vw, 5rem) 0 clamp(6rem, 10vw, 9rem);
  }

  /* See the note in src/pages/registry.astro: `.text-link` is declared per page across
     this site, and these are apps.astro's declarations verbatim. */
  .text-link {
    display: inline-flex;
    min-height: 44px;
    gap: 0.45rem;
    align-items: center;
    color: var(--coral-bright);
    font-weight: 650;
  }

  .back-link {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  h1 {
    max-width: 26ch;
    margin: 0.4rem 0 1rem;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    margin: 0 0 clamp(2.5rem, 5vw, 3.5rem);
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .verified {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--coral-bright);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  /* The verification callout: what was checked, against which release, and where corrections
     go. Surface fill and a line, the site's card treatment, because it is a compact fact. */
  .callout {
    max-width: 68ch;
    margin: 0 0 clamp(2.5rem, 5vw, 3.5rem);
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    color: var(--ink-soft);
  }

  .callout h2 {
    margin: 0 0 0.6rem;
    color: var(--ink);
    font-size: var(--fs-label);
    font-weight: 650;
  }

  .callout p {
    margin: 0 0 0.75rem;
  }

  .callout p:last-child {
    margin-bottom: 0;
  }

  .callout a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--coral-bright);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .claims {
    margin: 0 0 0.75rem;
    padding-left: 1.2rem;
  }

  .claim-verdict {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
  }

  /* The prose block. Two rules here are load-bearing rather than decorative:
     every link is sized to the site's 44px target floor (tests/browser/support.ts
     asserts it on every route in `qualityRoutes`, and an inline text link fails that
     by roughly twenty pixels), and `overflow-wrap: anywhere` keeps a long file path in
     a link or a code span from overflowing a 320px viewport, which the same assertion
     also checks. Do not "tidy" either one away. */
  .post-body {
    max-width: 68ch;
    color: var(--ink-soft);
  }

  .post-body :global(h2) {
    margin: clamp(3rem, 6vw, 4.5rem) 0 1rem;
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid var(--line);
    color: var(--ink);
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 500;
    line-height: 1.15;
  }

  .post-body :global(h3) {
    margin: 2.25rem 0 0.5rem;
    color: var(--ink-muted);
    font-size: 0.9375rem;
    font-weight: 550;
    line-height: 1.3;
  }

  .post-body :global(p) {
    margin: 0 0 1.15rem;
  }

  .post-body :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 1.15rem;
    padding-left: 1.35rem;
  }

  .post-body :global(li) {
    margin-bottom: 0.35rem;
  }

  .post-body :global(li)::marker {
    color: var(--ink-muted);
  }

  .post-body :global(code) {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }

  .post-body :global(a) {
    display: inline-block;
    max-width: 100%;
    min-width: 44px;
    padding-block: 0.6rem;
    color: var(--coral-bright);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .post-body :global(a:hover) {
    color: var(--coral);
  }

  .post-body :global(hr) {
    margin: clamp(3rem, 6vw, 4.5rem) 0;
    border: 0;
    border-top: 1px solid var(--line);
  }
</style>
