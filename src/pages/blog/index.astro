---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

// One read, at build time. Posts are source-controlled in src/content/blog/ (see
// src/content.config.ts) — nothing here is fetched in a reader's browser.
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const readableDate = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC"
});
---

<BaseLayout
  title="Writing · PersonalClaw"
  description="Posts about what PersonalClaw shipped, how each claim is checked against the release this site publishes, and which claims did not survive the check."
>
  <section class="writing">
    <div class="narrow">
      <h1 class="section-title">What shipped, and what did not.</h1>
      <p class="lede">
        Every post names the release its claims were verified against, and links the file
        that proves each one. When a claim holds in development but not in the released
        version this site publishes, the post says so instead of rounding up.
      </p>
      <p class="feed">
        <a href="/blog/rss.xml">Follow the RSS feed</a> in your own reader. There is no
        newsletter.
      </p>

      {
        posts.length === 0 ? (
          <p class="none">
            No posts yet. This page lists posts as they are published; it does not
            pretend to have any.
          </p>
        ) : (
          <ul class="post-list">
            {posts.map((post) => (
              <li class="post-item" data-blog-entry={post.id}>
                {/* The post's link is its title alone, so its name doesn't run the date,
                    the badge and the description together (B4 in docs/site-audit.md). */}
                <h2>
                  <a class="post-link" href={`/blog/${post.id}`} data-blog-title>
                    {post.data.title}
                  </a>
                </h2>
                <p class="post-meta">
                  <time datetime={post.data.publishDate.toISOString().slice(0, 10)}>
                    {readableDate.format(post.data.publishDate)}
                  </time>{" "}
                  <a class="verified" href="/release" data-blog-verified>
                    Verified against <span translate="no">{post.data.verifiedAgainst}</span>
                  </a>
                </p>
                <p class="post-description">{post.data.description}</p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .writing {
    padding: clamp(4rem, 8vw, 7rem) 0 clamp(6rem, 10vw, 9rem);
  }

  h1 {
    max-width: 24ch;
    margin: 0.4rem 0 1.5rem;
  }

  .lede {
    max-width: 62ch;
    margin: 0 0 clamp(2.5rem, 5vw, 3.5rem);
    color: var(--ink-soft);
  }

  .none {
    max-width: 62ch;
    color: var(--ink-muted);
  }

  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .feed {
    margin: -1.5rem 0 clamp(2.5rem, 5vw, 3.5rem);
    color: var(--ink-muted);
  }

  .feed a,
  .verified {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--coral-bright);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .post-item {
    display: grid;
    gap: 0.35rem;
    padding: clamp(1.4rem, 3vw, 1.9rem);
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
  }

  .post-item + .post-item {
    margin-top: 1rem;
  }

  .post-item h2 {
    margin: 0;
    font-size: var(--fs-title);
    font-weight: var(--fw-title);
    line-height: var(--lh-title);
  }

  .post-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--ink);
  }

  .post-link:hover {
    color: var(--coral-bright);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .post-meta,
  .post-description {
    margin: 0;
  }

  .post-description {
    max-width: 62ch;
    color: var(--ink-soft);
  }
</style>
