---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

// One read, at build time. Posts are source-controlled in src/content/blog/ (see
// src/content.config.ts) — nothing here is fetched in a reader's browser.
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const readableDate = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC"
});
---

<BaseLayout
  title="Writing · PersonalClaw"
  description="Posts about what PersonalClaw shipped, how each claim is checked against the release this site publishes, and which claims did not survive the check."
>
  <section class="writing">
    <div class="narrow">
      <p class="kicker">Writing</p>
      <h1 class="section-title">What shipped, and what did not.</h1>
      <p class="lede">
        Every post names the release its claims were verified against, and links the file
        that proves each one. When a claim holds in development but not in the released
        version this site publishes, the post says so instead of rounding up.
      </p>

      {
        posts.length === 0 ? (
          <p class="none">
            No posts yet. This page lists posts as they are published; it does not
            pretend to have any.
          </p>
        ) : (
          <ul class="post-list">
            {posts.map((post) => (
              <li class="post-item" data-blog-entry={post.id}>
                <a class="post-link" href={`/blog/${post.id}`}>
                  <span class="post-title" data-blog-title>{post.data.title}</span>
                  <span class="post-meta">
                    <time datetime={post.data.publishDate.toISOString().slice(0, 10)}>
                      {readableDate.format(post.data.publishDate)}
                    </time>
                    <span class="verified" translate="no">
                      Verified against {post.data.verifiedAgainst}
                    </span>
                  </span>
                  <span class="post-description">{post.data.description}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .writing {
    padding: clamp(4rem, 8vw, 7rem) 0 clamp(6rem, 10vw, 9rem);
  }

  h1 {
    max-width: 24ch;
    margin: 0.4rem 0 1.5rem;
  }

  .lede {
    max-width: 62ch;
    margin: 0 0 clamp(2.5rem, 5vw, 3.5rem);
    color: var(--ink-soft);
  }

  .none {
    max-width: 62ch;
    color: var(--ink-muted);
  }

  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-item + .post-item {
    margin-top: 1rem;
  }

  .post-link {
    display: grid;
    gap: 0.55rem;
    padding: clamp(1.4rem, 3vw, 1.9rem);
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
  }

  .post-link:hover {
    border-color: var(--line-strong);
  }

  .post-title {
    color: var(--ink);
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 500;
    line-height: 1.15;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .verified {
    color: var(--coral-bright);
  }

  .post-description {
    max-width: 62ch;
    color: var(--ink-soft);
  }
</style>
