---
import { Menu, X } from "lucide-react";
import { GITHUB_URL } from "../data/site";
import { currentOf } from "../data/navigation";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
// Five links and GitHub on the right (X7 in docs/site-audit.md). Compare lives in the footer
// and in the pages that send a reader to it; the install path is each page's own primary action,
// not a button in the chrome.
const links = [
  { href: "/product", label: "Product" },
  { href: "/apps", label: "Apps" },
  { href: "/security", label: "Security" },
  // `/docs`, not a specific guide. This pointed at /docs/guides/getting-started for as
  // long as there was no docs landing to send a reader to — which meant the nav chose a
  // page on the reader's behalf and gave them no view of the rest. The label and its
  // rendered box are unchanged, so the committed visual baselines still hold.
  { href: "/docs", label: "Docs" },
  { href: "/release", label: "Release" }
];
---

<header class="site-header" data-site-header>
  <div class="shell header-inner">
    <a class="brand-link" href="/" aria-label="PersonalClaw home">
      <img src="/brand/personalclaw-mark.svg" alt="" width="30" height="30" />
      <span translate="no">PersonalClaw</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {links.map((link) => (
        <a href={link.href} aria-current={currentOf(pathname, link.href)}>
          {link.label}
        </a>
      ))}
    </nav>

    <a class="header-github" href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>

    <button
      class="icon-button menu-button"
      type="button"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-button
    >
      <Menu className="menu-open-icon" size={22} aria-hidden="true" />
      <X className="menu-close-icon" size={22} aria-hidden="true" />
    </button>
  </div>

  <div
    id="mobile-menu"
    class="mobile-menu"
    data-mobile-menu
    aria-hidden="true"
    inert
  >
    <nav class="shell" aria-label="Mobile navigation">
      {links.map((link) => (
        <a href={link.href} aria-current={currentOf(pathname, link.href)}>
          {link.label}
        </a>
      ))}
      <a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const menu = header?.querySelector<HTMLElement>("[data-mobile-menu]");
  const button = header?.querySelector<HTMLButtonElement>("[data-menu-button]");

  const setMenuState = (open: boolean, restoreFocus = false) => {
    if (!menu || !button) return;
    menu.classList.toggle("is-open", open);
    button.setAttribute("aria-expanded", String(open));
    button.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
    menu.setAttribute("aria-hidden", String(!open));
    menu.toggleAttribute("inert", !open);
    if (restoreFocus) button.focus();
  };

  button?.addEventListener("click", () => {
    setMenuState(!menu?.classList.contains("is-open"));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && button?.getAttribute("aria-expanded") === "true") {
      setMenuState(false, true);
    }
  });

  // The menu exists only while its button does, and which one shows depends on the
  // header's width in rem (global.css), not on one viewport width: close the menu
  // whenever the button stops rendering, from a wider window or smaller text alike.
  if (button) {
    new ResizeObserver(() => {
      if (button.getClientRects().length === 0) setMenuState(false);
    }).observe(button);
  }
</script>
