---
import { GITHUB_URL, APPS_URL } from "../data/site";
import { releaseFacts } from "../data/release";
import { currentOf } from "../data/navigation";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const links = [
  { href: "/product", label: "Product" },
  { href: "/compare", label: "Compare" },
  { href: "/apps", label: "Apps" },
  { href: "/security", label: "Security" },
  { href: "/docs", label: "Docs" },
  { href: "/release", label: "Release" },
  { href: "/blog", label: "Blog" },
  { href: "/registry", label: "Registry" }
];

const releaseState =
  releaseFacts.channel === "released" ? "verified release" : "pinned snapshot";
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-brand">
      <a class="brand-link" href="/" aria-label="PersonalClaw home">
        <img src="/brand/personalclaw-mark.svg" alt="" width="30" height="30" />
        <span>PersonalClaw</span>
      </a>
      <p>One agentic OS. Your machine. Your rules.</p>
    </div>

    <nav class="footer-links" aria-label="Footer navigation">
      {links.map((link) => (
        <a href={link.href} aria-current={currentOf(pathname, link.href)}>
          {link.label}
        </a>
      ))}
      <a href={GITHUB_URL} target="_blank" rel="noreferrer">Source</a>
      <a href={APPS_URL} target="_blank" rel="noreferrer">App repository</a>
    </nav>

    <div class="footer-meta">
      <p>MIT licensed</p>
      <p>No usage tracking</p>
      <p>{releaseFacts.core.versionLabel} · {releaseState}</p>
    </div>
  </div>
  <div class="shell footer-bottom">
    <p>Built in the open for people who want to own their agents.</p>
  </div>
</footer>
