---
/*
 * One loop from the marketing manifest (#94): its poster first, a visible play and pause, and
 * the playback rules in ./loop-video.mjs. A page names the entry by id; the files, the box and
 * the autoplay policy are the manifest's, so a page cannot play a loop the manifest does not
 * declare, or one it has retired.
 */
import manifest from "../../marketing/screenshots.manifest.json";
import { loopVideoMarkup } from "./loop-video.mjs";

interface Props {
  /** The `videos` entry's id. */
  id: string;
  /** What the loop shows, for a screen reader. */
  label: string;
}

/** A `videos` entry, as marketing/screenshots.schema.json declares it. */
interface VideoEntry {
  id: string;
  kind: string;
  status: string;
  output: string;
  poster: string;
  width: number;
  height: number;
  autoplay: string;
  fallback: string;
}

const { id, label } = Astro.props;
// Typed here rather than inferred from the JSON: a manifest that declares no video yet infers
// `never[]`, which would type every field below as missing.
const videos: VideoEntry[] = manifest.videos ?? [];
const entry = videos.find((video) => video.id === id);
if (!entry) throw new Error(`no video "${id}" in marketing/screenshots.manifest.json`);
if (entry.kind !== "loop") throw new Error(`video "${id}" is a ${entry.kind} video, not a loop`);
if (entry.status !== "shipping") throw new Error(`video "${id}" is ${entry.status}, not shipping`);

const url = (rel: string) => `/${rel.replace(/^public\//, "")}`;
const markup = loopVideoMarkup({
  src: url(entry.output),
  poster: url(entry.poster),
  width: entry.width,
  height: entry.height,
  label,
  autoplay: entry.autoplay,
  fallback: entry.fallback
});
---

<Fragment set:html={markup} />

<script>
  import { mountLoopVideos } from "./loop-video.mjs";

  mountLoopVideos();
</script>

<style is:global>
  /* The markup is the module's (set:html), so these rules are global, under the loop's class. */
  .loop-video {
    position: relative;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--theater);
  }

  .loop-video video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .loop-toggle {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    padding: 0.55rem 1rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: color-mix(in srgb, var(--night) 82%, transparent);
    color: var(--ink);
    font: inherit;
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    cursor: pointer;
    transition: background-color 160ms ease;
  }

  .loop-toggle:hover {
    background: var(--theater-high);
  }

  .loop-fallback {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    left: 0.75rem;
    margin: 0;
    padding: 0.55rem 0.9rem;
    border-radius: 8px;
    background: color-mix(in srgb, var(--night) 88%, transparent);
    color: var(--ink-soft);
    font-size: var(--fs-label);
  }

  @media (forced-colors: active) {
    .loop-toggle {
      border-color: ButtonText;
    }
  }
</style>
