---
/*
 * One loop from the marketing manifest (#94): its poster first, a visible play and pause, and
 * the playback rules in ./loop-video.mjs. A page names the entry by id; the files, the box and
 * the autoplay policy are the manifest's, so a page cannot play a loop the manifest does not
 * declare, or one it has retired. An image in the default slot is the loop's still: it shows
 * until the loop plays, in place of the rendered poster. A narrative entry (the release clip,
 * #97) plays once, with its captions as the default track.
 */
import manifest from "../../marketing/screenshots.manifest.json";
import { manifestLoopMarkup } from "./loop-video.mjs";
import "./loop-video.css";

interface Props {
  /** The `videos` entry's id. */
  id: string;
  /** What the loop shows, for a screen reader. */
  label: string;
}

const { id, label } = Astro.props;
const still = Astro.slots.has("default") ? await Astro.slots.render("default") : undefined;
const markup = manifestLoopMarkup(manifest.videos ?? [], id, label, still);
---

<Fragment set:html={markup} />

<script>
  import { mountLoopVideos } from "./loop-video.mjs";

  mountLoopVideos();
</script>
