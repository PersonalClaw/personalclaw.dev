---
// Starlight's two-column content (TwoColumnContent.astro, @astrojs/starlight 0.42) with the main
// pane FIRST in the document. Starlight put the "On this page" aside first and moved it to the
// right with CSS `order`, so a screen reader and the Tab key met the table of contents before the
// page's own h1 (D6 in docs/site-audit.md). The order is now the document's; the `order` rules
// below only restate it. The phone's table of contents is `position: fixed` under the header,
// so where it sits in the document changes only when it is read, not where it shows.
---

<div class="lg:sl-flex">
  <div class="main-pane"><slot /></div>
  {
    Astro.locals.starlightRoute.toc && (
      <aside class="right-sidebar-container print:hidden">
        <div class="right-sidebar">
          <slot name="right-sidebar" />
        </div>
      </aside>
    )
  }
</div>

<style>
  @layer starlight.core {
    .main-pane {
      isolation: isolate;
    }

    @media (min-width: 72rem) {
      .right-sidebar-container {
        order: 2;
        position: relative;
        width: max(
          var(--sl-sidebar-width),
          calc(var(--sl-sidebar-width) + (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2)
        );
      }

      .right-sidebar {
        position: fixed;
        top: 0;
        border-inline-start: 1px solid var(--sl-color-hairline);
        padding-top: var(--sl-nav-height);
        width: 100%;
        height: 100vh;
        overflow-y: auto;
        scrollbar-width: none;
      }

      .main-pane {
        width: 100%;
      }

      :global([data-has-sidebar][data-has-toc]) .main-pane {
        --sl-content-margin-inline: auto 0;

        order: 1;
        width: min(
          calc(100% - var(--sl-sidebar-width)),
          calc(var(--sl-content-width) + (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2)
        );
      }
    }
  }
</style>
