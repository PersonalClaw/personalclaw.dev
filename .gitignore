node_modules/
dist/
.astro/
.DS_Store
playwright-report/
test-results/
.lighthouse/
.preview-dist/
.vercel/
.env*.local
.generated/
.source-cache/

# Raw screenshot captures staged for review before promotion into src/assets/
# (scripts/capture-app-shots.mjs). Review artifacts, not release content.
marketing/.captures/

# Core documentation synced at build time by scripts/sync-docs.mjs from the pinned
# core commit. NEVER commit these: one canonical source (the core repo) is the
# contract, and a committed copy is a copy that drifts.
src/content/docs/
public/llms.txt
public/llms-full.txt

# Owner-provided local secrets — the real file lives at the workspace root (outside
# every repo); this rule is belt-and-braces.
.secrets.env

# Throwaway build the registry render check produces (scripts/validate-registry-render.mjs).
.registry-probe-dist/
