{
  "name": "personalclaw.dev",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "sync:sources": "node scripts/sync-sources.mjs",
    "sync:registry": "node scripts/sync-registry.mjs",
    "dev": "npm run sync && ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "npm run sync && npm run check:astro && npm run build:site",
    "build:site": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:preview": "npm run sync && npm run build:preview:site",
    "build:preview:site": "VERCEL_ENV=preview ASTRO_TELEMETRY_DISABLED=1 astro build --outDir .preview-dist",
    "build:record": "node scripts/build-record.mjs write",
    "verify:build-record": "node scripts/build-record.mjs verify",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "npm run sync && npm run check:astro",
    "check:astro": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "validate:build": "node scripts/validate-build.mjs",
    "validate:registry": "node scripts/validate-registry-render.mjs",
    "validate:blog": "node scripts/validate-blog-render.mjs",
    "validate:compare": "node scripts/validate-compare-render.mjs",
    "validate:preview": "DIST_DIR=.preview-dist EXPECT_NOINDEX=1 node scripts/validate-build.mjs",
    "validate:visual-baselines": "node scripts/validate-visual-baselines.mjs",
    "validate:marketing-manifest": "node scripts/validate-marketing-manifest.mjs",
    "validate:design-tokens": "node scripts/validate-design-tokens.mjs",
    "validate:source-pins": "node scripts/validate-source-pins.mjs",
    "validate:release-parity": "node scripts/validate-release-parity.mjs",
    "validate:release-parity:offline": "RELEASE_PARITY_OFFLINE=1 node scripts/validate-release-parity.mjs",
    "validate:release-parity:strict": "RELEASE_PARITY_REQUIRE_REMOTE=1 node scripts/validate-release-parity.mjs",
    "check:served-installer": "node scripts/check-served-installer.mjs",
    "audit:lock": "node scripts/audit-lock.mjs",
    "test:unit": "node --test tests/ci-contract.test.mjs tests/supply-chain.test.mjs tests/audit-lock.test.mjs tests/visual-environment.test.mjs tests/run-ci-gates.test.mjs tests/build-record.test.mjs tests/docs-publication.test.mjs tests/llms-lead.test.mjs tests/sync-registry.test.mjs tests/served-installer.test.mjs tests/apps-snippet.test.mjs tests/sync-sources-releases.test.mjs tests/compare-row-ids.test.mjs",
    "test:static": "node scripts/run-ci-gates.mjs --static",
    "test:browser": "npm run build && playwright test",
    "test:browser:prebuilt": "node scripts/build-record.mjs verify && playwright test",
    "test:browser:report": "playwright show-report",
    "test:visual": "node scripts/run-visual.mjs",
    "test:visual:update": "npm run build && node scripts/run-visual.mjs --update-snapshots=all",
    "test:lighthouse": "npm run build && node scripts/lighthouse-audit.mjs",
    "test:lighthouse:prebuilt": "node scripts/build-record.mjs verify && node scripts/lighthouse-audit.mjs",
    "test:ci": "node scripts/run-ci-gates.mjs",
    "test:prepush": "sh scripts/run-prepush.sh",
    "hooks:install": "sh scripts/install-git-hooks.sh",
    "sync:docs": "node scripts/sync-docs.mjs",
    "sync": "npm run sync:sources && npm run sync:docs && npm run sync:registry"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/react": "^7.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.6",
    "@fontsource-variable/dm-sans": "^5.2.6",
    "@fontsource-variable/jetbrains-mono": "^5.2.6",
    "astro": "^7.3.8",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "cheerio": "^1.2.0",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "13.5.0",
    "smol-toml": "^1.9.1",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
}
